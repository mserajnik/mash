#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Michael Serajnik <https://github.com/mserajnik>
# SPDX-License-Identifier: AGPL-3.0-or-later

# mash is a Git-based CLI addon manager for old WoW clients.
#
# Clones Git repositories into a persistent cache, scans them for `.toc` files
# that match the configured interface version, and symlinks the matching addon
# directories into the client's `Interface/AddOns` directory.
#
# Targets Bash 3.2 (stock macOS) so it runs without `brew install bash`.
# Depends on Git plus the standard Unix utilities that ship with every system
# that ships Bash.
#
# See `mash --help` for usage.

set -euo pipefail

# Drop the repository-local Git variables a caller may have set (a Git hook
# sets several), which would point Git commands in a clone at another
# repository. Keep the `git -c` settings, as Git does for a submodule.
for mash_git_var in $(git rev-parse --local-env-vars 2>/dev/null); do
  case "$mash_git_var" in
    GIT_CONFIG_PARAMETERS | GIT_CONFIG_COUNT) ;;
    *) unset "$mash_git_var" ;;
  esac
done
unset mash_git_var

# ANSI codes are populated only when stdout is a TTY and `-q` is not set. The
# `c_*` token helpers and logger functions read these globals so callers can
# stay terse; when colors are off, every helper is a no-op pass-through.
COLOR_RESET=""
COLOR_BOLD=""
COLOR_DIM=""
COLOR_UNDERLINE=""
COLOR_RED=""
COLOR_GREEN=""
COLOR_YELLOW=""
COLOR_BLUE=""
COLOR_MAGENTA=""
COLOR_CYAN=""

VERBOSE=0
QUIET=0

# Populates the `COLOR_*` globals with ANSI escape sequences when stdout is a
# TTY and `-q` is not set; otherwise they stay empty so callers can interpolate
# them unconditionally.
setup_colors() {
  if [[ -t 1 && "$QUIET" -eq 0 ]]; then
    COLOR_RESET=$'\033[0m'
    COLOR_BOLD=$'\033[1m'
    COLOR_DIM=$'\033[2m'
    COLOR_UNDERLINE=$'\033[4m'
    COLOR_RED=$'\033[31m'
    COLOR_GREEN=$'\033[32m'
    COLOR_YELLOW=$'\033[33m'
    COLOR_BLUE=$'\033[34m'
    COLOR_MAGENTA=$'\033[35m'
    COLOR_CYAN=$'\033[36m'
  fi
}

# Token helpers. Each wraps its argument in the right ANSI codes for the
# semantic role; the codes are empty strings when stdout is not a TTY (or `-q`
# is set), so the helpers are pass-through in those modes.
c_repo() { printf '%s' "$COLOR_BOLD$1$COLOR_RESET"; }
c_addon() { printf '%s' "$COLOR_MAGENTA$1$COLOR_RESET"; }
c_path() { printf '%s' "$COLOR_BLUE$1$COLOR_RESET"; }
c_status() { printf '%s' "$COLOR_GREEN$1$COLOR_RESET"; }
c_hint() { printf '%s' "$COLOR_UNDERLINE$1$COLOR_RESET"; }
c_url() { printf '%s' "$COLOR_CYAN$1$COLOR_RESET"; }
c_dim() { printf '%s' "$COLOR_DIM$1$COLOR_RESET"; }
c_bold() { printf '%s' "$COLOR_BOLD$1$COLOR_RESET"; }

# Prints a line on stdout; respects `-q`.
log_info() {
  [[ "$QUIET" -eq 1 ]] && return 0
  printf '%s\n' "$*"
}

# Prints a warning line on stderr with a yellow `Warning:` prefix; not silenced
# by `-q` since warnings are always relevant.
log_warn() {
  printf '%sWarning:%s %s\n' "$COLOR_YELLOW" "$COLOR_RESET" "$*" >&2
}

# Prints an error line on stderr with a red `Error:` prefix and exits with
# status 1.
die() {
  printf '%sError:%s %s\n' "$COLOR_RED" "$COLOR_RESET" "$*" >&2
  exit 1
}

# Tracks temporary files so an unexpected exit (signal, `set -e`) does not leak
# them into `$TMPDIR`. A tracker file is used rather than a Bash array because
# `mash_mktemp` is typically invoked inside `$(...)` command substitution
# (which runs in a subshell), and array mutations made there do not propagate
# back to the parent. Writing the paths to a real file works regardless.
TMP_TRACKER=""

# Creates a temporary file via `mktemp`, in `<dir>` when given, registers it in
# `TMP_TRACKER` for the `EXIT` trap to clean up, and echoes its path.
mash_mktemp() {
  [[ -n "$TMP_TRACKER" ]] ||
    die "'TMP_TRACKER' not initialized (internal invariant)."
  local f
  if [[ $# -gt 0 ]]; then
    f="$(mktemp "$1/.mash.XXXXXX" 2>/dev/null)" ||
      die "Cannot create a temporary file in $(c_path_display "$1")."
  else
    f="$(mktemp 2>/dev/null)" || die "Cannot create a temporary file."
  fi
  printf '%s\n' "$f" >>"$TMP_TRACKER"
  printf '%s\n' "$f"
}

# A clone directory not yet recorded in the configuration, and its repository;
# `cleanup_pending_clone` removes it.
PENDING_CLONE=""
PENDING_REPO=""

# Removes the clone directory in `PENDING_CLONE`, if any, and its owner
# directory once that is empty. Keeps a clone the configuration already
# records, which an exit right after the configuration write would otherwise
# delete.
cleanup_pending_clone() {
  if [[ -n "$PENDING_CLONE" ]] && ! config_section_exists "repo:$PENDING_REPO"; then
    rm -rf "$PENDING_CLONE" || true
    rmdir "$(dirname "$PENDING_CLONE")" 2>/dev/null || true
  fi
  PENDING_CLONE=""
}

# `EXIT` trap handler: removes any pending clone directory and every temporary
# file recorded in `TMP_TRACKER`.
cleanup_on_exit() {
  cleanup_pending_clone
  if [[ -n "$TMP_TRACKER" && -f "$TMP_TRACKER" ]]; then
    local f
    while IFS= read -r f; do
      [[ -n "$f" ]] && rm -f "$f"
    done <"$TMP_TRACKER"
    rm -f "$TMP_TRACKER"
  fi
}

TMP_TRACKER="$(mktemp)" || die "Failed to create temporary file tracker."
trap cleanup_on_exit EXIT

# Echoes the absolute path of an existing directory. Avoids `readlink -f`
# (GNU-only); the caller is expected to verify existence beforehand.
abs_path() {
  (cd "$1" && pwd)
}

# Collapses the `$HOME` prefix to `~` for display.
tilde_path() {
  local path="$1"
  if [[ "$path" == "$HOME" ]]; then
    printf '~\n'
  elif [[ "$path" == "$HOME"/* ]]; then
    printf '~%s\n' "${path#"$HOME"}"
  else
    printf '%s\n' "$path"
  fi
}

# Convenience helper: tilde-collapses a filesystem path and applies `c_path`
# styling. Used wherever a path is rendered for the user.
c_path_display() {
  c_path "$(tilde_path "$1")"
}

# `CONFIG_PATH` and `DATA_DIR` are scoped to the active profile and resolved at
# dispatch time by `resolve_active_paths`. Commands that operate on the active
# profile (`add`, `pin`, `unpin`, `status`, `update`, `refresh`, `list`,
# `remove`) require these to be set; profile management commands (`init`,
# `use`, `drop`, `profile`) resolve their own paths.
CONFIG_PATH=""
DATA_DIR=""

# Echoes the root configuration directory (parent of all per-profile
# directories and of the `active` state file).
config_root() {
  printf '%s/mash\n' "${XDG_CONFIG_HOME:-$HOME/.config}"
}

# Echoes the root data directory (parent of all per-profile data directories).
data_root() {
  printf '%s/mash\n' "${XDG_DATA_HOME:-$HOME/.local/share}"
}

# Echoes the path of the state file for the active profile.
active_profile_file() {
  printf '%s/active\n' "$(config_root)"
}

# Echoes the configuration path for a named profile.
profile_config_path() {
  printf '%s/%s/config.ini\n' "$(config_root)" "$1"
}

# Echoes the data directory for a named profile.
profile_data_dir() {
  printf '%s/%s\n' "$(data_root)" "$1"
}

# With no argument, echoes the parent `clones` directory under `DATA_DIR`; with
# `<name>`, echoes the clone directory for that repository under
# `DATA_DIR/clones`.
clone_path() {
  if [[ $# -eq 0 ]]; then
    printf '%s/clones\n' "$DATA_DIR"
  else
    printf '%s/clones/%s\n' "$DATA_DIR" "$1"
  fi
}

# Validates a profile name. Rejects empty names, names exceeding 64 characters,
# names starting with `.` (would let the path-based wipes in `cmd_drop` resolve
# outside the intended profile directory) or `-` (would be intercepted as an
# unknown flag by the dispatcher's global flag pass), names containing slashes
# or whitespace, the reserved name `active` (which collides with the state
# file), and any of the subcommand names (so a profile cannot shadow a command
# in user-facing documentation). Dies with a descriptive message on failure.
validate_profile_name() {
  local name="$1"
  if [[ -z "$name" ]]; then
    die "Profile name must not be empty."
  fi
  if [[ ${#name} -gt 64 ]]; then
    die "Profile name $(c_bold "$name") exceeds 64 characters."
  fi
  case "$name" in
    .*) die "Profile name $(c_bold "$name") must not start with '.'." ;;
    -*) die "Profile name $(c_bold "$name") must not start with '-'." ;;
  esac
  if [[ "$name" == *[/[:space:]]* ]]; then
    die "Profile name $(c_bold "$name") must not contain slashes or whitespace."
  fi
  if [[ "$name" == "active" ]]; then
    die "Profile name $(c_bold "active") is reserved."
  fi
  # Keep the pattern list in sync with the help case and the dispatch case in
  # `parse_global_flags_and_dispatch`.
  case "$name" in
    init | use | drop | profile | add | pin | unpin | status | update | refresh | list | remove)
      die "Profile name $(c_bold "$name") is reserved (matches a subcommand)."
      ;;
  esac
}

# Reads the state file for the active profile. Echoes the profile name on
# success; returns non-zero with no output when the file is missing or empty.
read_active_profile() {
  local file
  file="$(active_profile_file)"
  [[ -f "$file" ]] || return 1
  local name
  name="$(head -n 1 "$file" | tr -d '[:space:]')"
  [[ -n "$name" ]] || return 1
  printf '%s\n' "$name"
}

# Atomically writes a profile name to the state file for the active profile.
# Writes to a sibling temporary file in `config_root` and `mv`s into place so
# the state file is never left half-written. The temporary path is registered
# in `TMP_TRACKER` so a signal between `mktemp` and `mv` does not leave a
# temporary file behind.
write_active_profile() {
  local name="$1"
  local dir file tmp
  dir="$(config_root)"
  file="$(active_profile_file)"
  mkdir -p "$dir" || die "Cannot create $(c_path_display "$dir")."
  tmp="$(mash_mktemp "$dir")" || exit 1
  printf '%s\n' "$name" >"$tmp"
  mv -f "$tmp" "$file" || {
    rm -f "$tmp"
    die "Cannot write to $(c_path_display "$file")."
  }
}

# Returns 0 if the profiles `<a>` and `<b>` are the same directory, which on a
# file system that ignores case includes names that differ only in case.
is_same_profile() {
  [[ -n "$1" && -n "$2" ]] || return 1
  [[ "$1" == "$2" || "$(config_root)/$1" -ef "$(config_root)/$2" ]]
}

# Lists the names of every profile under `config_root` that contains a
# `config.ini`, one per line, sorted. Stray non-directory entries (notably the
# `active` state file) and directories missing `config.ini` are skipped.
list_profiles() {
  local dir
  dir="$(config_root)"
  [[ -d "$dir" ]] || return 0
  local entry name
  for entry in "$dir"/*/; do
    [[ -d "$entry" ]] || continue
    name="${entry%/}"
    name="${name##*/}"
    if [[ -f "$dir/$name/config.ini" ]]; then
      printf '%s\n' "$name"
    fi
  done | sort_names
}

# Resolves the paths for the active profile into `CONFIG_PATH` and `DATA_DIR`.
# Strict: dies when the active state is missing, empty, or points to a profile
# that no longer exists. Called by every command that operates on the active
# profile (`add`, `pin`, `unpin`, `status`, `update`, `refresh`, `list`,
# `remove`).
resolve_active_paths() {
  local name
  if ! name="$(read_active_profile)"; then
    die "No active profile. Run $(c_hint "mash init <client-directory>") to create one."
  fi
  local cfg
  cfg="$(profile_config_path "$name")"
  if [[ ! -f "$cfg" ]]; then
    die "Active profile $(c_bold "$name") is missing. Run $(c_hint "mash use <other>") to switch. Or run $(c_hint "mash init") to create a new one."
  fi
  CONFIG_PATH="$cfg"
  DATA_DIR="$(profile_data_dir "$name")"
}

# Mutates `CONFIG_PATH` and `DATA_DIR` to point at the named profile. Lives in
# its own function so `with_profile_paths` can invoke it from inside a `(...)`
# subshell without shellcheck flagging the mutation as leaking to readers: the
# subshell scopes the change, and the cross-function call hides the mutation
# from the static analysis.
_set_profile_paths() {
  CONFIG_PATH="$(profile_config_path "$1")"
  DATA_DIR="$(profile_data_dir "$1")"
}

# Runs a function (or any command) with `CONFIG_PATH` and `DATA_DIR` set to the
# named profile's paths. The body runs in a `(...)` subshell so the mutation is
# automatically scoped; whether the callee returns non-zero or calls `die` the
# parent's globals stay untouched. Useful when a command needs to inspect or
# mutate another profile's state (e.g., `cmd_drop` cleaning symlinks owned by
# the profile it is deleting).
with_profile_paths() {
  local profile="$1"
  shift
  (
    _set_profile_paths "$profile"
    "$@"
  )
}

# Removes every mash-managed symlink for repositories recorded in the current
# `CONFIG_PATH`. Foreign files (non-symlinks, or symlinks pointing outside the
# current `DATA_DIR`) are left untouched. Intended to be called via
# `with_profile_paths` against a non-active profile (see `cmd_drop`).
drop_managed_symlinks() {
  local client_dir
  client_dir="$(config_get main client_dir 2>/dev/null || true)"
  [[ -n "$client_dir" ]] || return 0
  local addons_dir="$client_dir/Interface/AddOns"
  local repos repo_name section addon_name addon_reldir target
  repos="$(config_list_repos)"
  while IFS= read -r repo_name; do
    [[ -z "$repo_name" ]] && continue
    section="repo:$repo_name"
    while IFS=$'\t' read -r addon_name addon_reldir; do
      [[ -z "$addon_name" ]] && continue
      target="$addons_dir/$addon_name"
      if is_mash_symlink "$target"; then
        rm -f "$target"
      fi
    done < <(read_repo_addons "$section")
  done <<<"$repos"
}

# Resolves an `--interface <version>` argument to a numeric value. Accepts the
# lowercase shortcuts `vanilla` / `tbc` / `wotlk` (resolving to 11200 / 20400 /
# 30300 respectively) or a positive 1-6 digit integer. Dies with the same
# wording as the interactive prompt on invalid input.
parse_interface_version() {
  local input="$1"
  case "$input" in
    vanilla) printf '11200\n' ;;
    tbc) printf '20400\n' ;;
    wotlk) printf '30300\n' ;;
    *)
      if ! [[ "$input" =~ ^[1-9][0-9]{0,5}$ ]]; then
        die "Interface version must be 1-6 digits and non-zero."
      fi
      printf '%s\n' "$input"
      ;;
  esac
}

# All access goes through these helpers; they read/write the file from disk
# each call. The overhead is negligible in practice, and this avoids stale
# in-memory state. mash passes values to awk through `ENVIRON`, never `awk -v`,
# which would process backslash escapes in them.

# Prints the value of a key in a section. Empty output and non-zero exit if the
# key is missing.
config_get() {
  local section="$1"
  local key="$2"
  [[ -f "$CONFIG_PATH" ]] || return 1
  MASH_SECTION="$section" MASH_KEY="$key" awk '
    BEGIN {
      section = ENVIRON["MASH_SECTION"]
      key = ENVIRON["MASH_KEY"]
    }
    /^\[.*\]$/ {
      current = substr($0, 2, length($0) - 2)
      next
    }
    current == section && index($0, key "=") == 1 {
      print substr($0, length(key) + 2)
      found = 1
      exit
    }
    END { if (!found) exit 1 }
  ' "$CONFIG_PATH"
}

# Like `config_get`, but dies with a uniform "Missing 'key' in configuration
# section [section]." message when the key is absent. Used by command bodies
# that treat a missing key as a hard error.
config_get_required() {
  config_get "$1" "$2" ||
    die "Missing '$2' in configuration section [$1]."
}

# Verifies that a `[repo:<name>]` section exists; dies with the standard
# "<name> not found in configuration." message otherwise.
require_repo() {
  config_section_exists "repo:$1" ||
    die "$(c_repo "$1") not found in configuration."
}

# Returns 0 if the configuration file contains a section header matching
# `section`, non-zero otherwise.
config_section_exists() {
  local section="$1"
  [[ -f "$CONFIG_PATH" ]] || return 1
  MASH_SECTION="$section" awk '
    /^\[.*\]$/ {
      current = substr($0, 2, length($0) - 2)
      if (current == ENVIRON["MASH_SECTION"]) { found = 1; exit }
    }
    END { if (!found) exit 1 }
  ' "$CONFIG_PATH"
}

# Echoes the recorded repository name that equals `<name>`, or else one that
# equals it when ASCII case is ignored, or nothing. GitHub and most other hosts
# ignore case in these names.
config_find_repo() {
  config_list_repos | MASH_NAME="$1" LC_ALL=C awk '
    $0 == ENVIRON["MASH_NAME"] { exact = $0 }
    first == "" && tolower($0) == tolower(ENVIRON["MASH_NAME"]) { first = $0 }
    END { if (exact != "") print exact; else if (first != "") print first }
  '
}

# Lists every `[repo:*]` section name (the `repo:` prefix is stripped), sorted
# with `sort_names`. The file is kept in that order too, but a hand-edited file
# may not be.
config_list_repos() {
  [[ -f "$CONFIG_PATH" ]] || return 0
  awk '
    /^\[repo:.*\]$/ {
      name = substr($0, 7, length($0) - 7)
      print name
    }
  ' "$CONFIG_PATH" | sort_names
}

# Writes `$CONFIG_PATH` to `<out>` with the section `<section>` replaced by one
# built from the `<key>=<value>` lines after the first three arguments, or,
# with `<mode>` `remove`, without that section. A comment line (first non-blank
# character `;` or `#`) belongs to the next line that is not a comment or
# blank, or to the end of the file when none follows. So comments above the
# section's header and above each key it keeps survive the rewrite, and
# comments above a key it drops go with that key. Reads an absent
# `$CONFIG_PATH` as empty.
_config_rewrite_section() {
  local section="$1" mode="$2" out="$3"
  shift 3
  local src="$CONFIG_PATH" entries="" entry
  [[ -f "$src" ]] || src=/dev/null
  for entry in "$@"; do
    entries="$entries$entry"$'\n'
  done
  MASH_SECTION="$section" MASH_MODE="$mode" MASH_ENTRIES="$entries" awk '
    BEGIN {
      section = ENVIRON["MASH_SECTION"]
      n = split(ENVIRON["MASH_ENTRIES"], entry, "\n") - 1
    }
    /^[[:space:]]*$/ { next }
    /^[[:space:]]*[;#]/ { pending = pending $0 "\n"; next }
    /^\[.*\]$/ {
      in_section = (substr($0, 2, length($0) - 2) == section)
      if (in_section) {
        header_comments = header_comments pending
        pending = ""
        next
      }
    }
    in_section {
      key = $0
      sub(/=.*/, "", key)
      key_comments[key] = key_comments[key] pending
      pending = ""
      next
    }
    {
      printf "%s", pending
      pending = ""
      print
    }
    END {
      if (ENVIRON["MASH_MODE"] != "remove") {
        printf "%s", header_comments
        print "[" section "]"
        for (i = 1; i <= n; i++) {
          key = entry[i]
          sub(/=.*/, "", key)
          printf "%s", key_comments[key]
          print entry[i]
        }
      }
      printf "%s", pending
    }
  ' "$src" >"$out"
}

# Rewrites the configuration file `<file>` in place with its sections in
# canonical order: any lines before the first header, then `[main]`, then the
# `[repo:*]` sections sorted by repository name as `sort_names` sorts, then any
# other section, then any comments at the end of the file. Sections whose names
# are equal keep their order in the file. Comments move with the line they
# belong to (see `_config_rewrite_section`). Blank lines are dropped and one
# blank line separates each section. Awk has no portable sort, so each section
# is packed onto one line (a sort key, its position, then its lines, joined by
# `\001`) for `sort` and unpacked afterwards.
_config_sort_sections() {
  local file="$1"
  local sorted
  sorted="$(mash_mktemp "$(dirname "$file")")" || return 1
  if ! awk '
    function flush() {
      if (body != "") print key "\001" (++position) "\001" body
      body = ""
    }
    function add(line) {
      body = (body == "" ? line : body "\001" line)
    }
    BEGIN { key = "0" }
    /^[[:space:]]*$/ { next }
    /^[[:space:]]*[;#]/ {
      pending = (pending == "" ? $0 : pending "\001" $0)
      next
    }
    /^\[.*\]$/ {
      flush()
      name = substr($0, 2, length($0) - 2)
      if (name == "main") key = "1"
      else if (index(name, "repo:") == 1) key = "2" substr(name, 6)
      else key = "3" name
    }
    {
      if (pending != "") add(pending)
      pending = ""
      add($0)
    }
    END {
      flush()
      if (pending != "") {
        key = "4"
        body = pending
        flush()
      }
    }
  ' "$file" | LC_ALL=C sort -t $'\001' -k1,1f -k1,1 -k2,2n | awk '
    BEGIN { FS = "\001" }
    NR > 1 { print "" }
    { for (i = 3; i <= NF; i++) print $i }
  ' >"$sorted"; then
    rm -f "$sorted"
    return 1
  fi
  mv -f "$sorted" "$file" || {
    rm -f "$sorted"
    return 1
  }
}

# Rewrites `$CONFIG_PATH` with `_config_rewrite_section` (same arguments, minus
# `<out>`) and `_config_sort_sections`. Builds the new file next to the old one
# so the final `mv` is a rename on one file system, which leaves either the old
# file or the new one in place, never a partial file. Returns non-zero without
# touching the file when any step fails.
_config_replace_section() {
  local section="$1" mode="$2"
  shift 2
  local dir tmp
  dir="$(dirname "$CONFIG_PATH")"
  mkdir -p "$dir" || return 1
  tmp="$(mash_mktemp "$dir")" || return 1
  if _config_rewrite_section "$section" "$mode" "$tmp" "$@" &&
    _config_sort_sections "$tmp" &&
    mv -f "$tmp" "$CONFIG_PATH"; then
    return 0
  fi
  rm -f "$tmp"
  return 1
}

# Writes (creates or overwrites) a section with the provided `<key>=<value>`
# lines, in the section order that `_config_sort_sections` defines. Returns
# non-zero without touching the file when any step fails.
config_write_section() {
  local section="$1"
  shift
  _config_replace_section "$section" write "$@"
}

# Removes a section (and its `<key>=<value>` lines) from the configuration.
# Returns non-zero without touching the file when any step fails.
config_remove_section() {
  [[ -f "$CONFIG_PATH" ]] || return 0
  _config_replace_section "$1" remove
}

# Rewrites the `[repo:<name>]` section's metadata (`url`, `ref`, `ref_kind`,
# `pinned`) while preserving the existing `addons` value. Used by `mash pin`
# and `mash unpin`, which never change the addon set.
config_update_repo_metadata() {
  local name="$1" url="$2" ref="$3" ref_kind="$4" pinned="$5"
  local section="repo:$name"
  local addons_csv
  addons_csv="$(config_get "$section" addons 2>/dev/null || true)"
  config_write_section "$section" \
    "url=$url" \
    "ref=$ref" \
    "ref_kind=$ref_kind" \
    "pinned=$pinned" \
    "addons=$addons_csv" ||
    die "Cannot write $(c_path_display "$CONFIG_PATH")."
}

# Returns 0 if `input` is a pure `owner/repository` GitHub shorthand. URLs and
# inputs with dotted host segments are excluded so they fall through to the URL
# normalization path; otherwise both `normalize_name` and `expand_url` would
# have to keep their detection rules in sync independently. Any `:` also
# disqualifies (legitimate shorthand never contains one).
is_shorthand() {
  local input="$1"
  [[ "$input" != *:* && "$input" != *.*/* && "$input" =~ ^[^/]+/[^/]+$ ]]
}

# Strips all trailing `.git` suffixes case-insensitively. Tolerates user inputs
# like `owner/repository.git`, `owner/repository.GIT`, and the malformed double
# suffix `owner/repository.git.git`.
strip_git_suffix() {
  local s="$1"
  while [[ "$s" == *.[gG][iI][tT] ]]; do
    s="${s%.[gG][iI][tT]}"
  done
  printf '%s\n' "$s"
}

# Echoes the canonical name in `owner/repository` form (GitHub: bare
# `owner/repository`; other hosts: last two path components, stripped of
# `.git`). URLs with fewer than two path components after the host are
# rejected. Accepts any of:
# - `owner/repository` (GitHub shorthand)
# - `https://github.com/owner/repository[.git]`
# - `git@github.com:owner/repository.git`
# - `https://gitea.example.com/foo/bar[.git]`
# - `git@gitlab.com:foo/bar.git`
normalize_name() {
  local input="$1"
  if is_shorthand "$input"; then
    printf '%s\n' "$(strip_git_suffix "$input")"
    return 0
  fi
  local stripped
  # Strip protocol/host prefix.
  stripped="${input#https://}"
  stripped="${stripped#http://}"
  stripped="${stripped#git@}"
  # Normalize `host:owner/repository` (SSH form) to `host/owner/repository`.
  stripped="${stripped/://}"
  # Strip trailing `.git` (handles `.GIT` and malformed `.git.git`).
  stripped="$(strip_git_suffix "$stripped")"

  # Reject inputs that, after substitution, lack a host (e.g. leading `:` or
  # `://` got converted to a leading `/`).
  if [[ "$stripped" == /* ]]; then
    die "Could not normalize repository name from '$input' (no host component)."
  fi

  # Take the last two path components.
  local last second_last rest
  last="${stripped##*/}"
  rest="${stripped%/*}"
  if [[ "$rest" == "$stripped" ]]; then
    die "Could not normalize repository name from '$input'."
  fi
  second_last="${rest##*/}"
  if [[ -z "$last" || -z "$second_last" ]]; then
    die "Could not normalize repository name from '$input'."
  fi
  printf '%s/%s\n' "$second_last" "$last"
}

# Given user input, produces the URL to pass to `git clone`. Shorthand
# `owner/repository` is expanded to the GitHub HTTPS URL; everything else
# passes through unchanged.
expand_url() {
  local input="$1"
  if is_shorthand "$input"; then
    printf 'https://github.com/%s.git\n' "$(strip_git_suffix "$input")"
  else
    printf '%s\n' "$input"
  fi
}

# Probes writability of a directory with a temporary file that gets removed
# immediately afterwards.
ensure_writable() {
  local path="$1"
  local probe
  probe="$(mktemp "$path/.mash-write-probe.XXXXXX" 2>/dev/null)" ||
    die "Cannot write to $(c_path_display "$path")."
  rm -f "$probe"
}

# Dies with the standard "requires a value" message when an option lacks its
# value. Used by command parsers handling the `--flag <value>` form (the
# `--flag=value` form is parsed inline).
require_arg() {
  [[ "$2" -ge 2 ]] || die "$(c_hint "$1") requires a value."
}

# Matches the canonical lowercase form used elsewhere; accepts uppercase input.
is_sha() {
  [[ "$1" =~ ^[0-9a-fA-F]{7,40}$ ]]
}

# Lowercases a string via `tr` (Bash 3.2 lacks `${var,,}`).
to_lower() {
  printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]'
}

# Sorts lines case-insensitively, independent of the locale. Lines that differ
# only in case fall back to byte order, so the result is deterministic. Every
# list mash prints (profiles, repositories, addons) goes through this.
sort_names() {
  LC_ALL=C sort -f "$@"
}

# Returns 0 if the first argument equals any of the remaining arguments.
list_contains() {
  local needle="$1" item
  shift
  for item in "$@"; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

# Echoes the arguments after the first joined with `, `, each rendered through
# the function named by the first argument (for example, `c_addon`).
fmt_list() {
  local render="$1" out="" item
  shift
  for item in "$@"; do
    [[ -n "$out" ]] && out="$out, "
    out="$out$("$render" "$item")"
  done
  printf '%s\n' "$out"
}

# Defaults to `--quiet`; on `-v` streams progress via `--progress`.
run_git_clone() {
  local url="$1"
  local dest="$2"
  if [[ "$VERBOSE" -eq 1 ]]; then
    git clone --progress "$url" "$dest"
  elif [[ "$QUIET" -eq 1 ]]; then
    git clone --quiet "$url" "$dest" 2>&1
  else
    git clone --quiet "$url" "$dest"
  fi
}

# Runs `git` in the clone `<dir>`. `--git-dir` stops Git from searching upward,
# so a clone missing its `.git` fails here instead of acting on a repository
# that contains the data directory.
git_in() {
  local dir="$1"
  shift
  git -C "$dir" --git-dir=.git "$@"
}

# Resets a clone's `HEAD` and working tree to the given ref. Used for every
# state-set operation (`add`, `pin`, `unpin`, `update`); mash owns the clone
# unilaterally, so we never preserve local modifications. Detaches `HEAD` first
# so the reset moves `HEAD` itself rather than whatever local branch `HEAD`
# happened to point at (mash never reads the local branch name). The `|| true`
# keeps the detach best-effort on the rare chance the working tree is dirty;
# the reset cleans up regardless. Honors `$VERBOSE`.
run_git_reset_hard() {
  local dir="$1"
  local ref="$2"
  git_in "$dir" checkout --detach --quiet 2>/dev/null || true
  if [[ "$VERBOSE" -eq 1 ]]; then
    git_in "$dir" reset --hard "$ref"
  else
    git_in "$dir" reset --hard --quiet "$ref"
  fi
}

# Returns the name of the remote's default branch via the symref output. Dies
# if the remote did not advertise a symref (some older servers do not).
git_default_branch() {
  local url="$1"
  local out branch
  out="$(git ls-remote --symref "$url" HEAD 2>/dev/null | head -1)" ||
    die "Failed to resolve default branch for $(c_url "$url")."
  # Expected first line: `ref: refs/heads/<name>\tHEAD`.
  case "$out" in
    *"refs/heads/"*) ;;
    *) die "Remote $(c_url "$url") did not advertise a default branch (no symref). Pass an explicit ref." ;;
  esac
  branch="${out#*refs/heads/}"
  branch="${branch%%[[:space:]]*}"
  if [[ -z "$branch" ]]; then
    die "Failed to parse default branch for $(c_url "$url")."
  fi
  printf '%s\n' "$branch"
}

# Probes what kind of ref the user gave (branch or tag). Echoes the kind, or
# empty if neither matches.
probe_ref_kind() {
  local url="$1"
  local ref="$2"
  if git ls-remote --exit-code --heads "$url" "$ref" >/dev/null 2>&1; then
    printf 'branch\n'
    return 0
  fi
  if git ls-remote --exit-code --tags "$url" "$ref" >/dev/null 2>&1; then
    printf 'tag\n'
    return 0
  fi
  return 1
}

# Extracts the `## Interface: <number>` directive from a `.toc` file. Prints
# the number on the first match, or nothing. The match is case-insensitive on
# `Interface` (BSD `awk` has no `IGNORECASE`, so use `tolower` throughout).
toc_interface() {
  local file="$1"
  awk '
    {
      lower = tolower($0)
      if (lower ~ /^##[[:space:]]*interface[[:space:]]*:[[:space:]]*[0-9]+/) {
        n = lower
        sub(/^##[[:space:]]*interface[[:space:]]*:[[:space:]]*/, "", n)
        sub(/[[:space:]].*$/, "", n)
        if (n ~ /^[0-9]+$/) {
          print n
          exit
        }
      }
    }
  ' "$file"
}

# Scans a clone directory for addon locations whose `.toc` files match the
# configured interface version. Emits `<reldir>\t<toc1>,<toc2>,...` lines, one
# per addon location, sorted by `reldir` with `sort_names`. Empty output means
# no matching addons found.
scan_addons() {
  local clone_dir="$1"
  local want_version="$2"

  local tocs_file
  tocs_file="$(mash_mktemp)" || return 1

  # Collect all matching `.toc` files first as `<reldir>\t<toc-basename>`. Use
  # `-print0` / `read -d ''` for paths with whitespace, even though `.toc`
  # files in the wild never contain newlines.
  local toc_path reldir base iface
  while IFS= read -r -d '' toc_path; do
    iface="$(toc_interface "$toc_path")"
    if [[ "$iface" == "$want_version" ]]; then
      reldir="$(dirname -- "${toc_path#"$clone_dir"/}")"
      base="$(basename "$toc_path" .toc)"
      printf '%s\t%s\n' "$reldir" "$base" >>"$tocs_file"
    fi
  done < <(find "$clone_dir" -type f -name '*.toc' ! -path '*/.git/*' -print0)

  if [[ ! -s "$tocs_file" ]]; then
    return 0
  fi

  # Group by directory, then shallowest-wins prune. Sort directories by path
  # depth ascending so shorter prefixes appear first; iterate keeping only
  # those whose ancestor is not already kept. The root `.` has depth 0, so
  # every other location is below it and is dropped.
  local groups_file
  groups_file="$(mash_mktemp)" || return 1
  sort_names "$tocs_file" | awk -F'\t' '
    {
      tocs[$1] = (tocs[$1] == "" ? $2 : tocs[$1] "," $2)
    }
    END {
      for (d in tocs) print d "\t" tocs[d]
    }
  ' | awk -F'\t' '
    {
      n = ($1 == "." ? 0 : split($1, parts, "/"))
      printf "%d\t%s\t%s\n", n, $1, $2
    }
  ' | LC_ALL=C sort -t $'\t' -k1,1n -k2,2f >"$groups_file"

  local kept_file
  kept_file="$(mash_mktemp)" || return 1
  local dir tocs ancestor_match prior_dir
  while IFS=$'\t' read -r _ dir tocs; do
    ancestor_match=0
    if [[ -s "$kept_file" ]]; then
      while IFS=$'\t' read -r prior_dir _; do
        # Treat `.` as the root of the clone; everything is its descendant.
        if [[ "$prior_dir" == "." ]]; then
          ancestor_match=1
          break
        fi
        if [[ "$dir" == "$prior_dir"/* ]]; then
          ancestor_match=1
          break
        fi
      done <"$kept_file"
    fi
    if [[ "$ancestor_match" -eq 0 ]]; then
      printf '%s\t%s\n' "$dir" "$tocs" >>"$kept_file"
    fi
  done <"$groups_file"

  sort_names "$kept_file"
}

# Renders a relative directory for user-facing prose. The distinguished `.`
# value mash uses to denote "addon at clone root" gets substituted with the
# phrase "the repository root" because the literal `.` reads ambiguously when
# embedded in a sentence (especially when followed by a sentence period). Any
# other value is passed through `c_path`.
display_reldir() {
  if [[ "$1" == "." ]]; then
    printf 'the repository root'
  else
    c_path "$1"
  fi
}

# Echoes the user-facing display string for a repository's pinned/tracked
# state. Pinned repos (`ref_kind=commit`) read as `pinned: <short>`; others
# read as `<ref_kind>: <ref>, <short>`.
fmt_ref_display() {
  local ref="$1" ref_kind="$2" short="$3"
  if [[ "$ref_kind" == "commit" ]]; then
    printf 'pinned: %s\n' "$(c_dim "$short")"
  else
    printf '%s: %s, %s\n' "$ref_kind" "$(c_dim "$ref")" "$(c_dim "$short")"
  fi
}

# Scans a clone directory for every `.toc` file regardless of interface
# version. Emits `<reldir>\t<toc-basename>\t<interface>` lines, one per `.toc`.
# `<interface>` is the value of the `Interface:` directive or `?` if the file
# is missing it (malformed). Used by `fmt_no_matching_toc_error` to enrich the
# "no matching .toc" error in `cmd_add` and `cmd_refresh`.
scan_addons_unfiltered() {
  local clone_dir="$1"
  local toc_path reldir base iface
  while IFS= read -r -d '' toc_path; do
    iface="$(toc_interface "$toc_path")"
    [[ -z "$iface" ]] && iface="?"
    reldir="$(dirname -- "${toc_path#"$clone_dir"/}")"
    base="$(basename "$toc_path" .toc)"
    printf '%s\t%s\t%s\n' "$reldir" "$base" "$iface"
  done < <(find "$clone_dir" -type f -name '*.toc' ! -path '*/.git/*' -print0) |
    sort_names
}

# Builds the "No matching .toc" error message body for `cmd_add` and
# `cmd_refresh` to pass to `die`. Calls `scan_addons_unfiltered` to enumerate
# every `.toc` in the clone, then formats either an inline singular form (one
# `.toc` found) or a multi-line list (multiple). Falls back to a terse
# `No .toc files found in <repo>.` when the unfiltered scan is also empty.
fmt_no_matching_toc_error() {
  local clone_dir="$1"
  local name="$2"
  local interface_version="$3"

  local unfiltered
  unfiltered="$(scan_addons_unfiltered "$clone_dir")"
  if [[ -z "$unfiltered" ]]; then
    printf 'No .toc files found in %s.' "$(c_repo "$name")"
    return
  fi

  local count
  count="$(printf '%s\n' "$unfiltered" | wc -l | tr -d '[:space:]')"

  local reldir toc_name iface
  if [[ "$count" -eq 1 ]]; then
    IFS=$'\t' read -r reldir toc_name iface <<<"$unfiltered"
    printf 'No matching .toc in %s for configured interface version %s. Found %s (Interface: %s) at %s.' \
      "$(c_repo "$name")" \
      "$(c_dim "$interface_version")" \
      "$(c_addon "$toc_name")" \
      "$(c_dim "$iface")" \
      "$(display_reldir "$reldir")"
    return
  fi

  printf 'No matching .toc in %s for configured interface version %s. Found:' \
    "$(c_repo "$name")" \
    "$(c_dim "$interface_version")"
  while IFS=$'\t' read -r reldir toc_name iface; do
    [[ -z "$toc_name" ]] && continue
    printf '\n  %s (Interface: %s) at %s' \
      "$(c_addon "$toc_name")" \
      "$(c_dim "$iface")" \
      "$(display_reldir "$reldir")"
  done <<<"$unfiltered"
}

# Returns 0 when mash can prompt: stdin and stderr (where prompts go) are both
# terminals. Stdout is not checked because the pickers run inside `$(...)`.
can_prompt() {
  [[ -t 0 && -t 2 ]]
}

# Picks one of the candidates after the first five arguments and echoes it.
# When there is one candidate, it wins. Otherwise the first of these that names
# a candidate wins: `<requested>` (a `--toc` or `--dir` value), `<recorded>`
# (the choice an earlier `add` or `refresh` recorded), and an interactive
# prompt. Without a terminal to prompt on, dies with `<subject>` and a hint to
# pass `<hint>`. `<render>` names the function that styles each candidate (for
# example, `c_addon`).
pick_choice() {
  local subject="$1" hint="$2" render="$3" requested="$4" recorded="$5"
  shift 5
  if [[ $# -eq 1 ]]; then
    printf '%s\n' "$1"
    return 0
  fi
  local choice
  for choice in "$requested" "$recorded"; do
    if [[ -n "$choice" ]] && list_contains "$choice" "$@"; then
      printf '%s\n' "$choice"
      return 0
    fi
  done

  if ! can_prompt; then
    die "$subject. Pass $(c_hint "$hint") (candidates: $(fmt_list "$render" "$@"))."
  fi

  printf '%s\n' "$subject:" >&2
  local i=1 candidate
  for candidate in "$@"; do
    printf '  %d) %s\n' "$i" "$("$render" "$candidate")" >&2
    i=$((i + 1))
  done
  printf 'Pick one (or empty to abort): ' >&2
  choice=""
  if ! read -r choice; then
    printf '\n' >&2
  fi
  if [[ -z "$choice" ]]; then
    die "Aborted."
  fi
  if ! [[ "$choice" =~ ^[1-9][0-9]{0,8}$ ]] || [[ "$choice" -gt $# ]]; then
    die "Invalid choice '$choice'."
  fi
  local candidates=("$@")
  printf '%s\n' "${candidates[$((choice - 1))]}"
}

# Looks up an earlier choice in `<recorded>` (`<name>\t<reldir>` lines from
# `read_repo_addons`): echoes the other field of the one line whose field
# number `<field>` equals `<value>`, ignoring case for names (field 1). Echoes
# nothing when no line or several lines match, so a configuration that recorded
# a name twice prompts again.
recorded_choice() {
  printf '%s\n' "$1" | MASH_FIELD="$2" MASH_VALUE="$3" LC_ALL=C awk -F'\t' '
    BEGIN {
      field = ENVIRON["MASH_FIELD"]
      value = ENVIRON["MASH_VALUE"]
      if (field == 1) value = tolower(value)
    }
    # Append "" so that directories such as `1` and `01` compare as strings.
    (field == 1 ? tolower($1) : $2 "") == value {
      n++
      other = (field == 1 ? $2 : $1)
    }
    END { if (n == 1) print other }
  '
}

# Resolves `scan_addons` output to the addons to install and echoes them as
# `<name>\t<reldir>` lines, sorted by name. First picks one `.toc` name per
# location, then one location per name where several locations picked the same
# name, ignoring case (only one can own the symlink, and the client and some
# file systems ignore case). `<requested_toc>` and `<requested_dir>` are the
# `--toc` and `--dir` values: each must match a candidate somewhere and applies
# only where there is a choice to make. `<recorded>` holds the configuration's
# current `<name>\t<reldir>` lines (empty for `add`), so `refresh` reuses
# recorded choices.
resolve_addons() {
  local scan_output="$1" requested_toc="$2" requested_dir="$3" recorded="$4"
  local typed_dir="$requested_dir"

  # Accept `a/Foo/` and `./a/Foo` for `a/Foo`.
  while [[ "$requested_dir" == ?*/ ]]; do
    requested_dir="${requested_dir%/}"
  done
  while [[ "$requested_dir" == ./?* ]]; do
    requested_dir="${requested_dir#./}"
  done

  # Read the scan up front: the prompts in `pick_choice` read the answer from
  # stdin, so no loop around them may redirect it. This function runs inside
  # `$(...)`, where `set -e` is off. Each pick exits explicitly when
  # `pick_choice` dies.
  local dirs=() tocs_csv=() dir csv
  while IFS=$'\t' read -r dir csv; do
    [[ -z "$dir" ]] && continue
    dirs+=("$dir")
    tocs_csv+=("$csv")
  done <<<"$scan_output"

  local i j name options=() all_tocs=()
  for ((i = 0; i < ${#dirs[@]}; i++)); do
    IFS=',' read -r -a options <<<"${tocs_csv[$i]}"
    all_tocs+=("${options[@]}")
  done

  if [[ -n "$requested_toc" ]] && ! list_contains "$requested_toc" "${all_tocs[@]}"; then
    local shown=()
    while IFS= read -r name; do
      shown+=("$name")
    done < <(printf '%s\n' "${all_tocs[@]}" | sort_names | uniq)
    die "$(c_hint --toc) value '$requested_toc' did not match any .toc file (candidates: $(fmt_list c_addon "${shown[@]}"))."
  fi
  if [[ -n "$requested_dir" ]] && ! list_contains "$requested_dir" "${dirs[@]}"; then
    die "$(c_hint --dir) value '$typed_dir' did not match any addon directory (candidates: $(fmt_list display_reldir "${dirs[@]}"))."
  fi

  local names=() folded=()
  for ((i = 0; i < ${#dirs[@]}; i++)); do
    IFS=',' read -r -a options <<<"${tocs_csv[$i]}"
    name="$(pick_choice \
      "Multiple matching .toc files in $(display_reldir "${dirs[$i]}")" \
      "--toc <name>" c_addon "$requested_toc" \
      "$(recorded_choice "$recorded" 2 "${dirs[$i]}")" \
      "${options[@]}")" || exit 1
    names+=("$name")
    folded+=("$(to_lower "$name")")
  done

  local picked=() group=() prior seen
  for ((i = 0; i < ${#names[@]}; i++)); do
    seen=0
    for ((j = 0; j < i; j++)); do
      if [[ "${folded[$j]}" == "${folded[$i]}" ]]; then
        seen=1
        break
      fi
    done
    [[ "$seen" -eq 1 ]] && continue
    group=()
    for ((j = i; j < ${#names[@]}; j++)); do
      if [[ "${folded[$j]}" == "${folded[$i]}" ]]; then
        group+=("${dirs[$j]}")
      fi
    done
    # A recorded directory settles the collision unless another directory in
    # the group has a recorded line of its own; then the collision is new (a
    # `--toc` value can create one).
    prior="$(recorded_choice "$recorded" 1 "${names[$i]}")"
    for dir in "${group[@]}"; do
      if [[ "$dir" != "$prior" && -n "$(recorded_choice "$recorded" 2 "$dir")" ]]; then
        prior=""
      fi
    done
    dir="$(pick_choice \
      "Multiple directories provide $(c_addon "${names[$i]}")" \
      "--dir <addon-directory>" display_reldir "$requested_dir" "$prior" \
      "${group[@]}")" || exit 1
    for ((j = i; j < ${#names[@]}; j++)); do
      if [[ "${dirs[$j]}" == "$dir" ]]; then
        picked+=("${names[$j]}"$'\t'"$dir")
        break
      fi
    done
  done

  printf '%s\n' "${picked[@]}" | sort_names
}

# Echoes the first 7 chars of the commit hash at `HEAD` for a clone.
git_short_head() {
  git_in "$1" rev-parse --short=7 HEAD
}

# Fetches the origin remote for a clone. Adds `--tags` when the ref kind is
# `tag` (branch refs do not need it). Honors `$VERBOSE` by suppressing Git's
# progress output unless verbose mode is on.
fetch_origin() {
  local clone_dir="$1"
  local ref_kind="$2"
  local args=()
  [[ "$ref_kind" == "tag" ]] && args+=(--tags)
  [[ "$VERBOSE" -ne 1 ]] && args+=(--quiet)
  git_in "$clone_dir" fetch "${args[@]+"${args[@]}"}" origin
}

# Echoes the qualified Git ref for the given `ref` + `ref_kind`:
# `refs/tags/<ref>` for tags, `origin/<ref>` for branches, the raw value for
# commits.
resolve_checkout_ref() {
  case "$2" in
    tag) printf 'refs/tags/%s\n' "$1" ;;
    commit) printf '%s\n' "$1" ;;
    *) printf 'origin/%s\n' "$1" ;;
  esac
}

# Echoes the short commit hash at the target ref for a clone (`origin/<branch>`
# or `refs/tags/<tag>`). Assumes a prior `fetch_origin`. Returns non-zero with
# no output if the ref is not resolvable (e.g., upstream branch deleted).
# `^{commit}` resolves an annotated tag to its commit.
resolve_target_sha() {
  local clone_dir="$1"
  local ref="$2"
  local ref_kind="$3"
  git_in "$clone_dir" rev-parse --short=7 \
    "$(resolve_checkout_ref "$ref" "$ref_kind")^{commit}" 2>/dev/null
}

# Reads the four canonical keys (`url`, `ref`, `ref_kind`, `pinned`) for a
# repository's configuration section and assigns them via Bash's dynamic
# scoping to the caller's `url`, `ref`, `ref_kind`, and `pinned` variables.
# The caller MUST `local`-declare these names before the call (otherwise the
# values leak as globals). Dies with a descriptive message if any key is
# missing.
load_repo_config() {
  local repo_name="$1"
  local section="repo:$repo_name"
  url="$(config_get_required "$section" url)"
  ref="$(config_get_required "$section" ref)"
  ref_kind="$(config_get_required "$section" ref_kind)"
  pinned="$(config_get_required "$section" pinned)"
  # Pseudo-read so shellcheck treats the writes via dynamic scoping as "used".
  # The function's actual contract is to populate the caller's locals via
  # Bash's dynamic scoping; this line costs nothing at runtime and removes
  # per-key `disable=SC2034` annotations.
  : "$url" "$ref" "$ref_kind" "$pinned"
}

# Echoes where the symlink `target` points, made absolute if relative.
link_path() {
  local link
  link="$(readlink "$1")"
  if [[ "$link" != /* ]]; then
    link="$(dirname "$1")/$link"
  fi
  printf '%s\n' "$link"
}

# Returns 0 if `target` is a symlink into `<dir>` (default: the data directory,
# which marks a link mash created and may replace).
is_mash_symlink() {
  local target="$1" dir="${2:-$DATA_DIR}"
  [[ -L "$target" ]] || return 1
  path_below "$(link_path "$target")" "$dir" >/dev/null
}

# Echoes the part of `<path>` below the directory `<dir>`, empty for `<dir>`
# itself, and returns non-zero when `<path>` is not in `<dir>`. On a file
# system that ignores case, `<path>` may spell `<dir>` in another case (a link
# created while the profile was named in another case), so when the text
# differs, the leading directories of `<path>` are compared with `<dir>` on
# disk.
path_below() {
  local path="$1" dir="$2"
  if [[ "$path" == "$dir" || "$path" == "$dir"/* ]]; then
    path="${path#"$dir"}"
    printf '%s\n' "${path#/}"
    return 0
  fi
  local d="$dir" rest="$path" prefix=""
  while [[ "$d" == /?* && "$rest" == /?* ]]; do
    d="${d#"${d%%[!/]*}"}"
    rest="${rest#"${rest%%[!/]*}"}"
    prefix="$prefix/${rest%%/*}"
    if [[ "$d" == */* ]]; then d="/${d#*/}"; else d=""; fi
    if [[ "$rest" == */* ]]; then rest="/${rest#*/}"; else rest=""; fi
  done
  [[ -z "$d" && -n "$prefix" && "$prefix" -ef "$dir" ]] || return 1
  printf '%s\n' "${rest#/}"
}

# Echoes the repository whose clone the symlink `target` points into, and
# returns 0, if the configuration records that repository.
link_owner() {
  local target="$1" rest name
  [[ -L "$target" ]] || return 1
  rest="$(path_below "$(link_path "$target")" "$(clone_path)")" || return 1
  [[ "$rest" == */* ]] || return 1
  name="${rest%%/*}/"
  rest="${rest#*/}"
  name="$name${rest%%/*}"
  config_section_exists "repo:$name" || return 1
  printf '%s\n' "$name"
}

# Echoes the clone directory for `<name>` and returns 0 if the clone is on
# disk; dies with a re-clone hint otherwise. Used by commands that operate on
# an existing clone (`pin`, `unpin`, `refresh`).
require_clone() {
  local name="$1"
  local dir
  dir="$(clone_path "$name")"
  [[ -d "$dir/.git" ]] ||
    die "Clone missing at $(c_path_display "$dir"). Run $(c_hint "mash add $name") to re-clone."
  printf '%s\n' "$dir"
}

# Echoes the absolute filesystem path for an addon location given the clone
# directory and the recorded `reldir`. The distinguished `.` value means "addon
# at the clone root".
addon_source_path() {
  if [[ "$2" == "." ]]; then
    printf '%s\n' "$1"
  else
    printf '%s/%s\n' "$1" "$2"
  fi
}

# Parses a repository section's `addons=` field and emits one
# `<name>\t<reldir>` line per addon, sorted by name with `sort_names`. Empty
# input, which a successful `add` never writes, means no addons recorded.
read_repo_addons() {
  local section="$1"
  local csv
  if ! csv="$(config_get "$section" addons)"; then
    return 0
  fi
  [[ -z "$csv" ]] && return 0
  local IFS_save="$IFS"
  IFS=','
  # shellcheck disable=SC2206
  local pairs=($csv)
  IFS="$IFS_save"
  local pair name reldir
  for pair in "${pairs[@]}"; do
    name="${pair%%:*}"
    reldir="${pair#*:}"
    printf '%s\t%s\n' "$name" "$reldir"
  done | sort_names
}

# Echoes an error message ready to pass to `die` on the first target that
# exists but is not a mash-managed symlink, or that points into the clone of a
# recorded repository other than `<self>`, and returns non-zero. Echoes nothing
# and returns 0 otherwise. On a file system that ignores case, a target can be
# another repository's link under a name that differs only in case.
detect_target_conflict() {
  local self="$1" target kind other
  shift
  for target in "$@"; do
    if [[ -e "$target" || -L "$target" ]] && ! is_mash_symlink "$target"; then
      kind="path"
      [[ -L "$target" ]] && kind="symlink"
      [[ -d "$target" ]] && kind="directory"
      printf 'Target %s already exists (%s) and is not managed by mash.' \
        "$(c_path_display "$target")" "$kind"
      return 1
    fi
    if other="$(link_owner "$target")" && [[ "$other" != "$self" ]]; then
      printf 'Target %s already points into the clone of %s. To install it from %s, run %s first.' \
        "$(c_path_display "$target")" "$(c_repo "$other")" "$(c_repo "$self")" \
        "$(c_hint "mash remove $other")"
      return 1
    fi
  done
  return 0
}

# Echoes an error message ready to pass to `die` on an addon in `<resolved>`
# (`<name>\t<reldir>` lines) that another repository in the configuration
# already provides, ignoring case, and returns non-zero. Echoes nothing and
# returns 0 if no other repository provides any of them. `<self>` is the
# repository being added or refreshed.
detect_owner_conflict() {
  local self="$1" resolved="$2"
  [[ -f "$CONFIG_PATH" && -n "$resolved" ]] || return 0
  # In one pass over the configuration, read the new names (folded to lower
  # case) from `<resolved>`, then check every other repository's `addons=`
  # entries.
  local hit other new_name
  hit="$(printf '%s\n' "$resolved" | MASH_SELF="$self" LC_ALL=C awk '
    NR == FNR {
      split($0, field, "\t")
      if (field[1] != "") wanted[tolower(field[1])] = field[1]
      next
    }
    /^\[.*\]$/ {
      section = substr($0, 2, length($0) - 2)
      repo = (index(section, "repo:") == 1 ? substr(section, 6) : "")
      next
    }
    repo != "" && repo != ENVIRON["MASH_SELF"] && index($0, "addons=") == 1 {
      n = split(substr($0, 8), pairs, ",")
      for (i = 1; i <= n; i++) {
        owned = pairs[i]
        sub(/:.*/, "", owned)
        if (tolower(owned) in wanted) {
          print wanted[tolower(owned)] "\t" repo
          exit
        }
      }
    }
  ' - "$CONFIG_PATH")" || {
    printf 'Cannot read %s.' "$(c_path_display "$CONFIG_PATH")"
    return 1
  }
  [[ -n "$hit" ]] || return 0
  IFS=$'\t' read -r new_name other <<<"$hit"
  printf 'Addon %s is already provided by %s. To install it from %s, run %s first.' \
    "$(c_addon "$new_name")" "$(c_repo "$other")" "$(c_repo "$self")" \
    "$(c_hint "mash remove $other")"
  return 1
}

# Creates or replaces a symlink. Returns non-zero if the target exists but is
# not a mash-managed symlink (callers are expected to check for that case
# beforehand).
install_symlink_safe() {
  local source="$1"
  local target="$2"
  if [[ -e "$target" || -L "$target" ]] && ! is_mash_symlink "$target"; then
    return 1
  fi
  ln -sfn "$source" "$target"
}

# Checks the symlinks just installed in `<addons-dir>`, given as
# `<name>\t<source>` lines. Echoes an error message ready to pass to `die` and
# returns non-zero when a link no longer points at its source, which happens
# when the file system treats two addon names as one (for example, names that
# differ in case outside ASCII).
detect_shared_target() {
  local addons_dir="$1" installed="$2" name source link other_name other_source
  while IFS=$'\t' read -r name source; do
    [[ -n "$name" ]] || continue
    link="$(readlink "$addons_dir/$name" 2>/dev/null)" || link=""
    [[ "$link" == "$source" ]] && continue
    other_name=""
    while IFS=$'\t' read -r other_name other_source; do
      [[ "$other_source" == "$link" ]] && break
      other_name=""
    done <<<"$installed"
    if [[ -n "$other_name" ]]; then
      printf 'Addons %s and %s resolve to the same path on this file system' \
        "$(c_addon "$name")" "$(c_addon "$other_name")"
    else
      printf 'Symlink %s changed while mash installed it' \
        "$(c_path_display "$addons_dir/$name")"
    fi
    return 1
  done <<<"$installed"
  return 0
}

# Prints a `<name>\t<link>` line for each `<name>`, with the text of the
# symlink `<addons-dir>/<name>`, or nothing after the tab when there is none.
snapshot_links() {
  local addons_dir="$1" name link
  shift
  for name in "$@"; do
    link=""
    if [[ -L "$addons_dir/$name" ]]; then
      link="$(readlink "$addons_dir/$name")" || link=""
    fi
    printf '%s\t%s\n' "$name" "$link"
  done
}

# Puts the symlinks in `<addons-dir>` back as `snapshot_links` saved them in
# `<snapshot>`, after a failed `add` or `refresh`. The names that follow are
# the recorded ones: they are restored first, and the others only where the
# path is free, since on a file system that treats two names as one the other
# name is the same entry, and writing it can rename the entry. Keeps going past
# a failing step, then echoes the names whose links still differ from the
# snapshot, sorted with `sort_names`.
restore_links() {
  local addons_dir="$1" snapshot="$2" name link path
  shift 2
  # Remove the links that did not exist before, and the other names' changed
  # ones; `ln -sfn` below replaces the recorded names' links.
  while IFS=$'\t' read -r name link; do
    path="$addons_dir/$name"
    [[ -n "$name" && -L "$path" ]] || continue
    if [[ -z "$link" ]] ||
      { ! list_contains "$name" "$@" && [[ "$(readlink "$path")" != "$link" ]]; }; then
      rm -f "$path" || true
    fi
  done <<<"$snapshot"
  while IFS=$'\t' read -r name link; do
    path="$addons_dir/$name"
    [[ -n "$link" ]] || continue
    list_contains "$name" "$@" || continue
    [[ -L "$path" && "$(readlink "$path")" == "$link" ]] && continue
    ln -sfn "$link" "$path" || true
  done <<<"$snapshot"
  while IFS=$'\t' read -r name link; do
    path="$addons_dir/$name"
    [[ -n "$link" ]] || continue
    if list_contains "$name" "$@"; then
      continue
    fi
    [[ ! -e "$path" && ! -L "$path" ]] || continue
    ln -sfn "$link" "$path" || true
  done <<<"$snapshot"
  while IFS=$'\t' read -r name link; do
    path="$addons_dir/$name"
    [[ -n "$name" ]] || continue
    if [[ -z "$link" ]]; then
      [[ -L "$path" ]] || continue
    elif [[ -L "$path" && "$(readlink "$path")" == "$link" ]]; then
      continue
    fi
    printf '%s\n' "$name"
  done <<<"$snapshot" | sort_names
}

# Dies after a failed `add` or `refresh` whose links `restore_links` put back,
# with `<message>`. When some links in `<addons-dir>` could not be put back
# (`<unrestored>`, one name per line), names them and asks to run the command
# again.
die_rolled_back() {
  local addons_dir="$1" message="$2" unrestored="$3" names=() name
  [[ -n "$unrestored" ]] || die "$message (rolled back)."
  while IFS= read -r name; do
    [[ -z "$name" ]] || names+=("$name")
  done <<<"$unrestored"
  die "$message (could not restore $(fmt_list c_addon "${names[@]}") in $(c_path_display "$addons_dir"); run the command again)."
}

# Prompts the user for the client's TOC interface version
# (Vanilla/TBC/WotLK/custom) and echoes the chosen integer.
prompt_interface_version() {
  local choice version
  printf 'Pick the client TOC interface version:\n' >&2
  printf '  1) 11200 (Vanilla 1.12.1)\n' >&2
  printf '  2) 20400 (TBC 2.4.3)\n' >&2
  printf '  3) 30300 (WotLK 3.3.5a)\n' >&2
  printf '  4) Custom\n' >&2
  printf '> ' >&2
  read -r choice
  case "$choice" in
    1) version="$(parse_interface_version vanilla)" ;;
    2) version="$(parse_interface_version tbc)" ;;
    3) version="$(parse_interface_version wotlk)" ;;
    4)
      printf 'Enter interface version (digits only): ' >&2
      read -r version
      if ! [[ "$version" =~ ^[1-9][0-9]{0,5}$ ]]; then
        die "Interface version must be 1-6 digits and non-zero."
      fi
      ;;
    *)
      die "Invalid choice '$choice'."
      ;;
  esac
  printf '%s\n' "$version"
}

# Handles `mash init <client-directory> [--profile <name>] [--interface
# <version>]`: validates the client directory, creates `Interface/AddOns/` if
# missing, resolves the interface version (from the flag or via the interactive
# prompt), writes the initial `[main]` configuration section to the named
# profile, and sets that profile as active.
cmd_init() {
  local profile="default"
  local interface_arg=""
  local positional=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile)
        require_arg --profile "$#"
        profile="$2"
        shift 2
        ;;
      --profile=*)
        profile="${1#--profile=}"
        shift
        ;;
      --interface)
        require_arg --interface "$#"
        interface_arg="$2"
        shift 2
        ;;
      --interface=*)
        interface_arg="${1#--interface=}"
        shift
        ;;
      -*)
        die "Unknown option '$1'."
        ;;
      *)
        positional+=("$1")
        shift
        ;;
    esac
  done

  if [[ ${#positional[@]} -ne 1 ]]; then
    die "Usage: $(c_hint 'mash init <client-directory> [--profile <name>] [--interface <version>]')"
  fi
  local client_dir="${positional[0]}"

  validate_profile_name "$profile"

  if [[ -f "$(profile_config_path "$profile")" ]]; then
    if is_same_profile "$profile" "$(read_active_profile 2>/dev/null || true)"; then
      die "Profile $(c_bold "$profile") already exists and is active. To re-create it, switch to another profile ($(c_hint "mash use <name>"), or create one with $(c_hint "mash init <client-directory> --profile <name>")), then run $(c_hint "mash drop $profile")."
    fi
    die "Profile $(c_bold "$profile") already exists. Run $(c_hint "mash drop $profile") first to re-create it."
  fi

  if [[ ! -d "$client_dir" ]]; then
    die "Client directory $(c_path "$client_dir") does not exist."
  fi
  client_dir="$(abs_path "$client_dir")"

  # Resolve and validate the interface version before any filesystem mutation
  # so a bad `--interface` value does not leave a half-created `AddOns`
  # directory behind.
  local interface_version
  if [[ -n "$interface_arg" ]]; then
    interface_version="$(parse_interface_version "$interface_arg")"
  else
    interface_version="$(prompt_interface_version)"
  fi

  local addons_dir="$client_dir/Interface/AddOns"
  if [[ ! -d "$addons_dir" ]]; then
    mkdir -p "$addons_dir" || die "Failed to create $(c_path_display "$addons_dir")."
    log_info "$(c_status Created) $(c_path_display "$addons_dir")."
  fi
  ensure_writable "$addons_dir"

  CONFIG_PATH="$(profile_config_path "$profile")"
  DATA_DIR="$(profile_data_dir "$profile")"

  mkdir -p "$(dirname "$CONFIG_PATH")" ||
    die "Cannot create $(c_path_display "$(dirname "$CONFIG_PATH")")."
  mkdir -p "$(clone_path)" ||
    die "Cannot create $(c_path_display "$(clone_path)")."

  config_write_section "main" \
    "client_dir=$client_dir" \
    "interface_version=$interface_version" ||
    die "Cannot write $(c_path_display "$CONFIG_PATH")."

  write_active_profile "$profile"

  log_info "$(c_status Initialized) profile $(c_bold "$profile") at $(c_path_display "$CONFIG_PATH")."
}

# Handles `mash use <name>`: switches the active profile to `<name>`. The named
# profile must already exist (created via `mash init --profile`).
cmd_use() {
  if [[ $# -ne 1 ]]; then
    die "Usage: $(c_hint 'mash use <name>')"
  fi
  local name="$1"
  validate_profile_name "$name"
  if [[ ! -f "$(profile_config_path "$name")" ]]; then
    die "Profile $(c_bold "$name") does not exist. Run $(c_hint "mash init <client-directory> --profile $name") to create it. Or run $(c_hint "mash profile") to list available profiles."
  fi
  write_active_profile "$name"
  log_info "$(c_status Switched) to profile $(c_bold "$name")."
}

# Handles `mash drop <name>`: removes mash-managed symlinks for every
# repository in the profile, then deletes the profile's configuration and data
# directories. Refuses to drop the active profile and refuses to drop the only
# profile.
cmd_drop() {
  if [[ $# -ne 1 ]]; then
    die "Usage: $(c_hint 'mash drop <name>')"
  fi
  local name="$1"
  validate_profile_name "$name"
  if [[ ! -f "$(profile_config_path "$name")" ]]; then
    die "Profile $(c_bold "$name") does not exist."
  fi
  local active
  active="$(read_active_profile 2>/dev/null || true)"
  if is_same_profile "$name" "$active"; then
    die "Profile $(c_bold "$name") is active. Run $(c_hint "mash use <other>") first."
  fi
  local profile_count
  profile_count="$(list_profiles | wc -l | tr -d '[:space:]')"
  if [[ "$profile_count" == "1" ]]; then
    die "Cannot drop the only profile. Create a new one first with $(c_hint "mash init <client-directory> --profile <name>")."
  fi

  with_profile_paths "$name" drop_managed_symlinks

  # `validate_profile_name` rejected empty / unsafe names earlier; bind to
  # locals so the `rm -rf` paths can never collapse to a parent directory.
  local profile_config_dir profile_data
  profile_config_dir="$(config_root)/${name:?}"
  profile_data="$(profile_data_dir "${name:?}")"
  rm -rf "$profile_config_dir"
  rm -rf "$profile_data"

  log_info "$(c_status Dropped) profile $(c_bold "$name")."
}

# Handles `mash profile`: lists every configured profile, marking the active
# one with `*` in `git branch` style.
cmd_profile() {
  if [[ $# -gt 0 ]]; then
    die "Usage: $(c_hint 'mash profile')"
  fi
  local profiles
  profiles="$(list_profiles)"
  if [[ -z "$profiles" ]]; then
    log_info "No profiles configured."
    return 0
  fi
  local active
  active="$(read_active_profile 2>/dev/null || true)"
  local name
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    if is_same_profile "$name" "$active"; then
      log_info "* $(c_bold "$name")"
    else
      log_info "  $name"
    fi
  done <<<"$profiles"
}

# Handles `mash add <repository> [<ref>] [--toc <name>] [--dir
# <addon-directory>]`: normalizes the repository identifier, resolves `ref` and
# `ref_kind` (branch, tag, or pinned commit), clones into the data directory,
# detects matching addons by `.toc`, installs symlinks into the client's
# `Interface/AddOns/`, and records the result in a `[repo:<name>]`
# configuration section. Rolls back the clone and any partially-installed
# symlinks on failure.
cmd_add() {
  local requested_toc=""
  local requested_dir=""
  local batch_file=""
  local positional=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --toc)
        require_arg --toc "$#"
        requested_toc="$2"
        shift 2
        ;;
      --toc=*)
        requested_toc="${1#--toc=}"
        shift
        ;;
      --dir)
        require_arg --dir "$#"
        requested_dir="$2"
        shift 2
        ;;
      --dir=*)
        requested_dir="${1#--dir=}"
        shift
        ;;
      --file)
        require_arg --file "$#"
        batch_file="$2"
        shift 2
        ;;
      --file=*)
        batch_file="${1#--file=}"
        shift
        ;;
      -*)
        die "Unknown option '$1'."
        ;;
      *)
        positional+=("$1")
        shift
        ;;
    esac
  done

  if [[ -n "$batch_file" ]]; then
    if [[ ${#positional[@]} -gt 0 || -n "$requested_toc" || -n "$requested_dir" ]]; then
      die "$(c_hint "--file") is mutually exclusive with positional arguments, $(c_hint "--toc"), and $(c_hint "--dir")."
    fi
    cmd_add_batch "$batch_file"
    return $?
  fi

  if [[ ${#positional[@]} -lt 1 || ${#positional[@]} -gt 2 ]]; then
    die "Usage: $(c_hint 'mash add <repository> [<ref>] [--toc <name>] [--dir <addon-directory>] | --file <file>')"
  fi

  local repo_input="${positional[0]}"
  local ref_input=""
  if [[ ${#positional[@]} -eq 2 ]]; then
    ref_input="${positional[1]}"
  fi

  local name url
  name="$(normalize_name "$repo_input")"
  url="$(expand_url "$repo_input")"

  local recorded_as
  recorded_as="$(config_find_repo "$name")"
  if [[ "$recorded_as" == "$name" ]]; then
    die "$(c_repo "$name") is already added. Run $(c_hint "mash update") to apply available updates. To re-add from scratch, run $(c_hint "mash remove") first."
  elif [[ -n "$recorded_as" ]]; then
    die "$(c_repo "$name") is already added as $(c_repo "$recorded_as")."
  fi

  # Resolve `ref` and `ref_kind`.
  local ref ref_kind pinned
  if [[ -z "$ref_input" ]]; then
    ref="$(git_default_branch "$url")"
    ref_kind="branch"
    pinned="false"
  elif is_sha "$ref_input"; then
    ref="$(to_lower "$ref_input")"
    ref_kind="commit"
    pinned="true"
  else
    local kind
    if kind="$(probe_ref_kind "$url" "$ref_input")"; then
      ref="$ref_input"
      ref_kind="$kind"
      pinned="false"
    else
      die "Ref '$ref_input' not found upstream (not a branch, tag, or commit hash)."
    fi
  fi

  local client_dir interface_version addons_dir
  client_dir="$(config_get_required main client_dir)"
  interface_version="$(config_get_required main interface_version)"
  addons_dir="$client_dir/Interface/AddOns"
  ensure_writable "$addons_dir"

  local clone_dir
  clone_dir="$(clone_path "$name")"
  if [[ -e "$clone_dir" ]]; then
    die "Clone directory $(c_path_display "$clone_dir") already exists (orphan from a previous run?). Remove it manually and retry."
  fi

  # From here on, any exit must clean up the partial clone and its owner
  # directory. The `EXIT` trap does this when `PENDING_CLONE` is set; `cmd_add`
  # clears it once the configuration records the clone.
  PENDING_CLONE="$clone_dir"
  PENDING_REPO="$name"
  mkdir -p "$(dirname "$clone_dir")" ||
    die "Cannot create $(c_path_display "$(dirname "$clone_dir")")."
  ensure_writable "$(dirname "$clone_dir")"
  log_info "Cloning $(c_repo "$name") from $(c_url "$url")..."
  if ! run_git_clone "$url" "$clone_dir"; then
    die "Failed to clone $(c_url "$url")."
  fi

  if ! run_git_reset_hard "$clone_dir" "$(resolve_checkout_ref "$ref" "$ref_kind")"; then
    die "Failed to switch to $ref_kind $(c_dim "$ref")."
  fi

  # Detect addons.
  local scan_output
  scan_output="$(scan_addons "$clone_dir" "$interface_version")"
  if [[ -z "$scan_output" ]]; then
    die "$(fmt_no_matching_toc_error "$clone_dir" "$name" "$interface_version")"
  fi

  # Resolve the addons to one `.toc` name and one location each, then collect
  # the chosen names, their source `reldir` (relative to clone), and the
  # absolute target path for symlink creation.
  local resolved
  resolved="$(resolve_addons "$scan_output" "$requested_toc" "$requested_dir" "")"
  local chosen_tocs=()
  local chosen_reldirs=()
  local chosen_sources=()
  local chosen_targets=()
  local reldir chosen_toc source target
  while IFS=$'\t' read -r chosen_toc reldir; do
    [[ -z "$chosen_toc" ]] && continue
    source="$(addon_source_path "$clone_dir" "$reldir")"
    target="$addons_dir/$chosen_toc"
    chosen_tocs+=("$chosen_toc")
    chosen_reldirs+=("$reldir")
    chosen_sources+=("$source")
    chosen_targets+=("$target")
  done <<<"$resolved"

  # Preflight: confirm no addon is owned by another repository and no symlink
  # target conflicts before mutating the file system.
  local i conflict
  if ! conflict="$(detect_owner_conflict "$name" "$resolved")"; then
    die "$conflict"
  fi
  if ! conflict="$(detect_target_conflict "$name" "${chosen_targets[@]}")"; then
    die "$conflict"
  fi

  # The `addons=` field is a comma-separated list of
  # `<target-name>:<source-reldir>` pairs (`reldir` is `.` when the addon lives
  # at the repository root).
  local addons_csv=""
  local pair
  for ((i = 0; i < ${#chosen_tocs[@]}; i++)); do
    pair="${chosen_tocs[$i]}:${chosen_reldirs[$i]}"
    if [[ -z "$addons_csv" ]]; then
      addons_csv="$pair"
    else
      addons_csv="$addons_csv,$pair"
    fi
  done

  # Install symlinks, then record them in the configuration. If any step fails,
  # put the links back as they were; the `EXIT` trap then removes the clone so
  # the next attempt starts from a clean slate.
  local before installed_lines="" failed=0 shared=""
  before="$(snapshot_links "$addons_dir" "${chosen_tocs[@]}")"
  for ((i = 0; i < ${#chosen_targets[@]}; i++)); do
    if install_symlink_safe "${chosen_sources[$i]}" "${chosen_targets[$i]}"; then
      installed_lines+="${chosen_tocs[$i]}"$'\t'"${chosen_sources[$i]}"$'\n'
    else
      failed=1
      break
    fi
  done
  if [[ "$failed" -eq 0 ]] && ! shared="$(detect_shared_target "$addons_dir" "$installed_lines")"; then
    failed=1
  fi
  if [[ "$failed" -eq 0 ]] && ! config_write_section "repo:$name" \
    "url=$url" \
    "ref=$ref" \
    "ref_kind=$ref_kind" \
    "pinned=$pinned" \
    "addons=$addons_csv"; then
    failed=1
  fi
  if [[ "$failed" -eq 1 ]]; then
    [[ -n "$shared" ]] || shared="Failed to install $(c_repo "$name")"
    die_rolled_back "$addons_dir" "$shared" "$(restore_links "$addons_dir" "$before")"
  fi

  # The configuration now records the clone, so clear the trap's rollback hook:
  # no later exit (a closed stdout, for example) may delete the clone.
  PENDING_CLONE=""

  local short
  short="$(git_short_head "$clone_dir")"
  local ref_display
  ref_display="$(fmt_ref_display "$ref" "$ref_kind" "$short")"
  log_info "$(c_status Installed) $(c_repo "$name") ($ref_display)."
  for ((i = 0; i < ${#chosen_targets[@]}; i++)); do
    log_info "  $(c_addon "${chosen_tocs[$i]}") -> $(c_path_display "${chosen_sources[$i]}")"
  done
}

# Handles `mash add --file <file>` (batch add). Reads one entry per line from
# `<file>` (or stdin when `<file>` is `-`). Each line contains the arguments of
# a positional `mash add` invocation. Blank lines and lines starting with `#`
# are skipped. Each entry runs in a subshell so a `die` inside the per-entry
# `cmd_add` aborts only that entry, not the whole batch. Repositories that are
# already added are skipped with a log line. Emits a summary at the end and
# returns non-zero if any entry failed.
cmd_add_batch() {
  local file="$1"
  if [[ "$file" == "-" ]]; then
    file="/dev/stdin"
  elif [[ ! -r "$file" ]]; then
    die "Cannot read batch file $(c_path "$file")."
  fi
  if [[ -d "$file" ]]; then
    die "Batch file $(c_path "$file") is a directory."
  fi

  local n_added=0 n_skipped=0 n_failed=0
  local line line_no=0
  local entry_args first_arg has_file repo_name recorded_as rc signalled i

  # A failed `read` leaves `line` as it was, so it is cleared first.
  while line="" && IFS= read -r line || [[ -n "$line" ]]; do
    line_no=$((line_no + 1))
    # Split on whitespace into argv-style entries, without expanding globs,
    # after dropping the carriage returns of CRLF line endings. Quote handling
    # is not supported; addons whose `--toc` value contains whitespace cannot
    # be expressed via the batch file (rare; `.toc` file names in the wild do
    # not contain whitespace).
    read -r -a entry_args <<<"${line//$'\r'/}"
    # Skip blank and full-line comment lines.
    [[ ${#entry_args[@]} -eq 0 ]] && continue
    [[ "${entry_args[0]:0:1}" == "#" ]] && continue

    # The repository is the first argument that is neither a flag nor the value
    # of `--toc` or `--dir`, as on the command line.
    first_arg=""
    has_file=0
    for ((i = 0; i < ${#entry_args[@]}; i++)); do
      case "${entry_args[$i]}" in
        --file | --file=*) has_file=1 ;;
        --toc | --dir) i=$((i + 1)) ;;
        -*) ;;
        *) [[ -n "$first_arg" ]] || first_arg="${entry_args[$i]}" ;;
      esac
    done
    if [[ "$has_file" -eq 1 ]]; then
      log_warn "Line $line_no: $(c_hint "--file") is not allowed in a batch file."
      n_failed=$((n_failed + 1))
      continue
    fi
    if [[ -z "$first_arg" ]]; then
      log_warn "Line $line_no: no repository given."
      n_failed=$((n_failed + 1))
      continue
    fi
    if ! repo_name="$(normalize_name "$first_arg" 2>/dev/null)"; then
      log_warn "Line $line_no: '$first_arg' is not a valid repository identifier."
      n_failed=$((n_failed + 1))
      continue
    fi

    recorded_as="$(config_find_repo "$repo_name")"
    if [[ -n "$recorded_as" ]]; then
      if [[ "$recorded_as" == "$repo_name" ]]; then
        log_info "$(c_status Skipped) $(c_repo "$repo_name") (already added)."
      else
        log_info "$(c_status Skipped) $(c_repo "$repo_name") (already added as $(c_repo "$recorded_as"))."
      fi
      n_skipped=$((n_skipped + 1))
      continue
    fi

    # Invoke `cmd_add` for this entry in a subshell so a `die` aborts only this
    # entry rather than the whole batch. The subshell does not inherit the
    # `EXIT` trap, so it sets its own to remove a partial clone. Bash 3.2 skips
    # that trap on SIGTERM and SIGHUP, so this shell also marks the clone the
    # entry may create as pending and cleans it up afterwards; the
    # recorded-clone guard in `cleanup_pending_clone` keeps a clone the entry
    # recorded. A SIGTERM or SIGHUP sent to this shell alone takes effect only
    # after the subshell exits. The cleanup then never deletes a clone the
    # entry still uses. Bash ignores `set -e` inside a command tested by `if`
    # or `||`, which would let a failing `$(...)` in `cmd_add` carry on, so run
    # the subshell as a plain command with `set -e` re-enabled inside it.
    if [[ ! -e "$(clone_path "$repo_name")" ]]; then
      PENDING_CLONE="$(clone_path "$repo_name")"
      PENDING_REPO="$repo_name"
    fi
    signalled=0
    trap 'signalled=143' TERM
    trap 'signalled=129' HUP
    set +e
    (
      trap - TERM HUP
      trap cleanup_pending_clone EXIT
      set -e
      cmd_add "${entry_args[@]}"
    )
    rc=$?
    set -e
    trap - TERM HUP
    cleanup_pending_clone
    [[ "$signalled" -eq 0 ]] || exit "$signalled"
    if [[ "$rc" -eq 0 ]]; then
      n_added=$((n_added + 1))
    else
      log_warn "Line $line_no: failed to add $(c_repo "$repo_name")."
      n_failed=$((n_failed + 1))
    fi
  done <"$file"

  log_info "$n_added added, $n_skipped skipped, $n_failed failed."

  if [[ "$n_failed" -gt 0 ]]; then
    return 1
  fi
}

# Handles `mash pin <repository> [<commit-hash>]`: freezes a repository at a
# specific commit. With no `<commit-hash>`, freezes at the clone's current
# `HEAD`. With a `<commit-hash>`, validates it, checks it out (fetching first
# if it is not in the local clone yet), then freezes. Writes
# `ref=<commit-hash>`, `ref_kind=commit`, `pinned=true` to the configuration
# section. A repeat `mash pin <repo>` against the same already-pinned commit
# hash is a no-op success.
cmd_pin() {
  if [[ $# -lt 1 || $# -gt 2 ]]; then
    die "Usage: $(c_hint 'mash pin <repository> [<commit-hash>]')"
  fi
  local name
  name="$(normalize_name "$1")"
  require_repo "$name"

  local clone_dir
  clone_dir="$(require_clone "$name")"

  local url ref ref_kind pinned
  load_repo_config "$name"

  local requested_sha=""
  if [[ $# -eq 2 ]]; then
    requested_sha="$2"
    if ! is_sha "$requested_sha"; then
      die "Pin target '$requested_sha' is not a commit hash (expected 7-40 hex characters)."
    fi
    requested_sha="$(to_lower "$requested_sha")"
  fi

  if [[ -n "$requested_sha" ]]; then
    # Try locally first; on failure, fetch broadly (branches and tags) then
    # retry once. The `"tag"` argument coerces `fetch_origin` into adding
    # `--tags`, so commits reachable only from tag refs also resolve.
    if ! run_git_reset_hard "$clone_dir" "$requested_sha" 2>/dev/null; then
      if ! fetch_origin "$clone_dir" "tag"; then
        die "Failed to fetch $(c_repo "$name") from $(c_url "$url")."
      fi
      if ! run_git_reset_hard "$clone_dir" "$requested_sha"; then
        die "Failed to switch to commit $(c_dim "$requested_sha") in $(c_repo "$name") (not found locally or upstream)."
      fi
    fi
  fi
  local new_sha
  new_sha="$(git_short_head "$clone_dir")"

  if [[ "$pinned" == "true" && "$ref" == "$new_sha" ]]; then
    log_info "$(c_repo "$name") is already pinned to $(c_dim "$new_sha")."
    return 0
  fi

  config_update_repo_metadata "$name" "$url" "$new_sha" commit true

  log_info "$(c_status Pinned) $(c_repo "$name") ($(c_dim "$new_sha"))."
}

# Handles `mash unpin <repository> [<ref>]`: unpins a repository and switches
# its tracking ref. With no `<ref>`, switches back to the origin's default
# branch. With a `<ref>`, treats it as a branch or tag (existing
# `probe_ref_kind` logic). Writes `ref=<resolved-ref>`,
# `ref_kind=<branch|tag>`, `pinned=false` to the configuration section.
cmd_unpin() {
  if [[ $# -lt 1 || $# -gt 2 ]]; then
    die "Usage: $(c_hint 'mash unpin <repository> [<ref>]')"
  fi
  local name
  name="$(normalize_name "$1")"
  require_repo "$name"

  local clone_dir
  clone_dir="$(require_clone "$name")"

  local url ref ref_kind pinned
  load_repo_config "$name"

  if [[ "$pinned" != "true" ]]; then
    die "$(c_repo "$name") is not pinned."
  fi

  local target_ref target_kind
  if [[ $# -eq 2 ]]; then
    target_ref="$2"
    if ! target_kind="$(probe_ref_kind "$url" "$target_ref")"; then
      die "Ref '$target_ref' not found upstream (not a branch or tag)."
    fi
  else
    target_ref="$(git_default_branch "$url")"
    target_kind="branch"
  fi

  if ! fetch_origin "$clone_dir" "$target_kind"; then
    die "Failed to fetch $(c_repo "$name") from $(c_url "$url")."
  fi
  if ! run_git_reset_hard "$clone_dir" "$(resolve_checkout_ref "$target_ref" "$target_kind")"; then
    die "Failed to switch to $target_kind $(c_dim "$target_ref") in $(c_repo "$name")."
  fi

  local new_sha
  new_sha="$(git_short_head "$clone_dir")"

  config_update_repo_metadata "$name" "$url" "$target_ref" "$target_kind" false

  log_info "$(c_status Unpinned) $(c_repo "$name") ($target_kind: $(c_dim "$target_ref"), $(c_dim "$new_sha"))."
}

# Checks one repository for available updates without mutating the working
# state. Emits the per-repository status line and returns a code identifying
# the outcome: 0 (up to date), 10 (updates available), 20 (skipped: pinned or
# clone missing), 30 (fetch or ref resolution failed). Any other non-zero
# return is treated as failure by `cmd_status`'s tally; for example,
# `load_repo_config` dies with `rc=1` when a configuration key is missing. Body
# is a subshell so a `die` inside aborts only this check and not the whole
# `cmd_status` loop.
status_one_repo() (
  local repo_name="$1"
  local url ref ref_kind pinned clone_dir old_sha new_sha

  load_repo_config "$repo_name"
  clone_dir="$(clone_path "$repo_name")"

  if [[ ! -d "$clone_dir/.git" ]]; then
    log_warn "Skipped $(c_repo "$repo_name") (clone missing at $(c_path_display "$clone_dir"))."
    return 20
  fi

  old_sha="$(git_short_head "$clone_dir")"

  if [[ "$pinned" == "true" ]]; then
    log_info "$(c_status Skipped) $(c_repo "$repo_name") (pinned to $(c_dim "$old_sha"))."
    return 20
  fi

  if ! fetch_origin "$clone_dir" "$ref_kind"; then
    log_warn "Failed to fetch $(c_repo "$repo_name") from $(c_url "$url")."
    return 30
  fi

  if ! new_sha="$(resolve_target_sha "$clone_dir" "$ref" "$ref_kind")"; then
    log_warn "Ref $(c_dim "$ref") for $(c_repo "$repo_name") no longer exists upstream."
    return 30
  fi

  if [[ "$old_sha" == "$new_sha" ]]; then
    log_info "$(c_repo "$repo_name") is up to date ($(c_dim "$new_sha"))."
    return 0
  else
    log_info "$(c_repo "$repo_name") $(c_status 'has updates') ($(c_dim "$old_sha")..$(c_dim "$new_sha"))."
    return 10
  fi
)

# Handles `mash status [<repository>]`: fetches and reports which repositories
# have upstream updates available, without mutating the working state. Iterates
# by calling `status_one_repo`, tallies the outcomes for a final summary line
# (only when checking multiple repositories), and returns non-zero if any fetch
# or ref resolution failed.
cmd_status() {
  if [[ $# -gt 1 ]]; then
    die "Usage: $(c_hint 'mash status [<repository>]')"
  fi

  local repos
  if [[ $# -eq 1 ]]; then
    local name
    name="$(normalize_name "$1")"
    require_repo "$name"
    repos="$name"
  else
    repos="$(config_list_repos)"
    if [[ -z "$repos" ]]; then
      log_info "No repositories to check."
      return 0
    fi
  fi

  local repo_name rc
  local n_up=0 n_updates=0 n_skipped=0 n_failed=0 n_total=0
  while IFS= read -r repo_name; do
    [[ -z "$repo_name" ]] && continue
    rc=0
    status_one_repo "$repo_name" || rc=$?
    case "$rc" in
      0) n_up=$((n_up + 1)) ;;
      10) n_updates=$((n_updates + 1)) ;;
      20) n_skipped=$((n_skipped + 1)) ;;
      *) n_failed=$((n_failed + 1)) ;;
    esac
    n_total=$((n_total + 1))
  done <<<"$repos"

  if [[ "$n_total" -gt 1 ]]; then
    log_info "$n_up up to date, $n_updates with updates available, $n_skipped skipped."
  fi

  if [[ "$n_failed" -gt 0 ]]; then
    return 1
  fi
}

# Updates a single repository. Body is a subshell (note the `( ... )` instead
# of `{ ... }`) so a `die` inside aborts only this update and not the whole
# `cmd_update` loop over multiple repositories.
update_one_repo() (
  local repo_name="$1"
  local interface_version="$2"
  local section="repo:$repo_name"
  local url ref ref_kind pinned clone_dir old_sha new_sha
  local addon_name addon_reldir toc_dir toc_file iface drift

  load_repo_config "$repo_name"
  clone_dir="$(clone_path "$repo_name")"

  if [[ ! -d "$clone_dir/.git" ]]; then
    log_warn "Skipped $(c_repo "$repo_name") (clone missing at $(c_path_display "$clone_dir"))."
    return 0
  fi

  old_sha="$(git_short_head "$clone_dir")"

  if [[ "$pinned" == "true" ]]; then
    log_info "$(c_status Skipped) $(c_repo "$repo_name") (pinned to $(c_dim "$old_sha"))."
    return 0
  fi

  if ! fetch_origin "$clone_dir" "$ref_kind"; then
    log_warn "Failed to fetch $(c_repo "$repo_name") from $(c_url "$url")."
    return 1
  fi

  if ! run_git_reset_hard "$clone_dir" "$(resolve_checkout_ref "$ref" "$ref_kind")"; then
    log_warn "Failed to reset $(c_repo "$repo_name") to $ref_kind $(c_dim "$ref")."
    return 1
  fi

  new_sha="$(git_short_head "$clone_dir")"

  # Layout drift check: every recorded addon must still resolve to a file whose
  # `Interface` directive matches the configured version.
  drift=0
  while IFS=$'\t' read -r addon_name addon_reldir; do
    [[ -z "$addon_name" ]] && continue
    toc_dir="$(addon_source_path "$clone_dir" "$addon_reldir")"
    toc_file="$toc_dir/${addon_name}.toc"
    if [[ ! -f "$toc_file" ]]; then
      drift=1
      break
    fi
    iface="$(toc_interface "$toc_file")"
    if [[ "$iface" != "$interface_version" ]]; then
      drift=1
      break
    fi
  done < <(read_repo_addons "$section")

  if [[ "$drift" -eq 1 ]]; then
    die "Addon layout in $(c_repo "$repo_name") changed upstream. Run $(c_hint "mash refresh $repo_name") to re-detect."
  fi

  if [[ "$old_sha" == "$new_sha" ]]; then
    log_info "$(c_repo "$repo_name") is up to date ($(c_dim "$new_sha"))."
  else
    log_info "$(c_status Updated) $(c_repo "$repo_name") ($(c_dim "$old_sha")..$(c_dim "$new_sha"))."
  fi
)

# Handles `mash update [<repository>]`: updates one named repository or all
# configured repositories. Iterates by calling `update_one_repo` and returns
# non-zero if any update failed.
cmd_update() {
  if [[ $# -gt 1 ]]; then
    die "Usage: $(c_hint 'mash update [<repository>]')"
  fi

  local repos
  if [[ $# -eq 1 ]]; then
    local name
    name="$(normalize_name "$1")"
    require_repo "$name"
    repos="$name"
  else
    repos="$(config_list_repos)"
    if [[ -z "$repos" ]]; then
      log_info "No repositories to update."
      return 0
    fi
  fi

  local interface_version
  interface_version="$(config_get_required main interface_version)"

  local repo_name failed=0
  while IFS= read -r repo_name; do
    [[ -z "$repo_name" ]] && continue
    if ! update_one_repo "$repo_name" "$interface_version"; then
      failed=$((failed + 1))
    fi
  done <<<"$repos"

  if [[ "$failed" -gt 0 ]]; then
    return 1
  fi
}

# Handles `mash refresh <repository> [--toc <name>] [--dir <addon-directory>]`:
# re-detects addons in the existing clone and reconciles symlinks to match.
# Does not fetch, checkout, or reset. The recovery path for the "addon layout
# changed upstream" error that `mash update` emits when a `.toc` was added,
# removed, renamed, or moved. On any failure mid-step, rolls back the symlink
# changes made in this invocation and exits non-zero.
cmd_refresh() {
  local requested_toc=""
  local requested_dir=""
  local positional=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --toc)
        require_arg --toc "$#"
        requested_toc="$2"
        shift 2
        ;;
      --toc=*)
        requested_toc="${1#--toc=}"
        shift
        ;;
      --dir)
        require_arg --dir "$#"
        requested_dir="$2"
        shift 2
        ;;
      --dir=*)
        requested_dir="${1#--dir=}"
        shift
        ;;
      -*)
        die "Unknown option '$1'."
        ;;
      *)
        positional+=("$1")
        shift
        ;;
    esac
  done

  if [[ ${#positional[@]} -ne 1 ]]; then
    die "Usage: $(c_hint 'mash refresh <repository> [--toc <name>] [--dir <addon-directory>]')"
  fi

  local name
  name="$(normalize_name "${positional[0]}")"
  require_repo "$name"
  local section="repo:$name"

  local client_dir interface_version addons_dir
  client_dir="$(config_get_required main client_dir)"
  interface_version="$(config_get_required main interface_version)"
  addons_dir="$client_dir/Interface/AddOns"
  ensure_writable "$addons_dir"

  local clone_dir
  clone_dir="$(require_clone "$name")"

  # Load `url`, `ref`, `ref_kind`, `pinned` to preserve them when rewriting the
  # section after the new addon set is computed.
  local url ref ref_kind pinned
  load_repo_config "$name"

  local scan_output
  scan_output="$(scan_addons "$clone_dir" "$interface_version")"
  if [[ -z "$scan_output" ]]; then
    die "$(fmt_no_matching_toc_error "$clone_dir" "$name" "$interface_version")"
  fi

  local recorded
  recorded="$(read_repo_addons "$section")"

  local old_tocs=() old_reldirs=()
  local addon_name addon_reldir
  while IFS=$'\t' read -r addon_name addon_reldir; do
    [[ -z "$addon_name" ]] && continue
    old_tocs+=("$addon_name")
    old_reldirs+=("$addon_reldir")
  done <<<"$recorded"

  local resolved
  resolved="$(resolve_addons "$scan_output" "$requested_toc" "$requested_dir" "$recorded")"
  local new_tocs=() new_reldirs=() new_sources=() new_targets=()
  local reldir chosen_toc source target
  while IFS=$'\t' read -r chosen_toc reldir; do
    [[ -z "$chosen_toc" ]] && continue
    source="$(addon_source_path "$clone_dir" "$reldir")"
    target="$addons_dir/$chosen_toc"
    new_tocs+=("$chosen_toc")
    new_reldirs+=("$reldir")
    new_sources+=("$source")
    new_targets+=("$target")
  done <<<"$resolved"

  # Removed addons: in the old set, not in the new set.
  local removed_tocs=()
  local i j found
  for ((i = 0; i < ${#old_tocs[@]}; i++)); do
    found=0
    for ((j = 0; j < ${#new_tocs[@]}; j++)); do
      if [[ "${old_tocs[$i]}" == "${new_tocs[$j]}" ]]; then
        found=1
        break
      fi
    done
    if [[ "$found" -eq 0 ]]; then
      removed_tocs+=("${old_tocs[$i]}")
    fi
  done

  # Preflight: refuse if another repository provides any of the new addons, or
  # if any new target path is taken.
  local conflict
  if ! conflict="$(detect_owner_conflict "$name" "$resolved")"; then
    die "$conflict"
  fi
  if ! conflict="$(detect_target_conflict "$name" "${new_targets[@]}")"; then
    die "$conflict"
  fi

  # Apply changes. If a step fails, put the links back as they were.
  local before name_removed old_target installed_lines="" rollback=0 shared=""
  local removed_links=()
  before="$(snapshot_links "$addons_dir" ${new_tocs[@]+"${new_tocs[@]}"} ${removed_tocs[@]+"${removed_tocs[@]}"})"
  for name_removed in ${removed_tocs[@]+"${removed_tocs[@]}"}; do
    old_target="$addons_dir/$name_removed"
    if is_mash_symlink "$old_target" "$clone_dir"; then
      if ! rm -f "$old_target"; then
        rollback=1
        break
      fi
      removed_links+=("$name_removed")
    fi
  done
  if [[ "$rollback" -eq 0 ]]; then
    for ((i = 0; i < ${#new_targets[@]}; i++)); do
      if install_symlink_safe "${new_sources[$i]}" "${new_targets[$i]}"; then
        installed_lines+="${new_tocs[$i]}"$'\t'"${new_sources[$i]}"$'\n'
      else
        rollback=1
        break
      fi
    done
  fi
  if [[ "$rollback" -eq 0 ]] && ! shared="$(detect_shared_target "$addons_dir" "$installed_lines")"; then
    rollback=1
  fi

  local addons_csv="" pair
  for ((i = 0; i < ${#new_tocs[@]}; i++)); do
    pair="${new_tocs[$i]}:${new_reldirs[$i]}"
    if [[ -z "$addons_csv" ]]; then
      addons_csv="$pair"
    else
      addons_csv="$addons_csv,$pair"
    fi
  done

  if [[ "$rollback" -eq 0 ]] && ! config_write_section "$section" \
    "url=$url" \
    "ref=$ref" \
    "ref_kind=$ref_kind" \
    "pinned=$pinned" \
    "addons=$addons_csv"; then
    rollback=1
  fi

  if [[ "$rollback" -eq 1 ]]; then
    [[ -n "$shared" ]] || shared="Failed to refresh $(c_repo "$name")"
    die_rolled_back "$addons_dir" "$shared" \
      "$(restore_links "$addons_dir" "$before" ${old_tocs[@]+"${old_tocs[@]}"})"
  fi

  # Detect whether the symlink set actually changed; the "no changes" carve-out
  # is useful when the user ran `refresh` defensively, or when only
  # non-membership `.toc` fields (Notes, Title, etc.) shifted.
  local changed=0
  if [[ ${#new_tocs[@]} -ne ${#old_tocs[@]} ]]; then
    changed=1
  else
    for ((i = 0; i < ${#new_tocs[@]}; i++)); do
      found=0
      for ((j = 0; j < ${#old_tocs[@]}; j++)); do
        if [[ "${new_tocs[$i]}" == "${old_tocs[$j]}" && "${new_reldirs[$i]}" == "${old_reldirs[$j]}" ]]; then
          found=1
          break
        fi
      done
      if [[ "$found" -eq 0 ]]; then
        changed=1
        break
      fi
    done
  fi

  # A link that had to be put back is a change too.
  if [[ "$changed" -eq 0 ]]; then
    for ((i = 0; i < ${#new_tocs[@]}; i++)); do
      if ! grep -qxF -- "${new_tocs[$i]}"$'\t'"${new_sources[$i]}" <<<"$before"; then
        changed=1
        break
      fi
    done
  fi

  if [[ "$changed" -eq 0 ]]; then
    log_info "$(c_status Refreshed) $(c_repo "$name") (no changes)."
  else
    log_info "$(c_status Refreshed) $(c_repo "$name")."
    for ((i = 0; i < ${#new_targets[@]}; i++)); do
      log_info "  $(c_addon "${new_tocs[$i]}") -> $(c_path_display "${new_sources[$i]}")"
    done
    for name_removed in ${removed_links[@]+"${removed_links[@]}"}; do
      log_info "  $(c_addon "$name_removed") (removed)"
    done
  fi
}

# Handles `mash list`: prints every configured repository with its ref/commit
# and the addons it provides, in a hierarchical layout.
cmd_list() {
  if [[ $# -gt 0 ]]; then
    die "Usage: $(c_hint 'mash list')"
  fi

  local repos
  repos="$(config_list_repos)"
  if [[ -z "$repos" ]]; then
    log_info "No repositories installed."
    return 0
  fi

  local first=1
  local repo_name section url ref ref_kind pinned short ref_display
  local clone_dir addon_name addon_reldir source_path
  while IFS= read -r repo_name; do
    [[ -z "$repo_name" ]] && continue
    if [[ $first -eq 0 && "$QUIET" -eq 0 ]]; then
      printf '\n'
    fi
    first=0
    section="repo:$repo_name"
    load_repo_config "$repo_name"
    # `url` is set by `load_repo_config` via dynamic scoping but `cmd_list`
    # never reads it. The pseudo-read silences SC2034; the local declaration
    # above keeps the value from leaking as a global.
    : "$url"
    clone_dir="$(clone_path "$repo_name")"
    if [[ -d "$clone_dir/.git" ]]; then
      short="$(git_short_head "$clone_dir")"
    else
      short="?"
    fi
    ref_display="$(fmt_ref_display "$ref" "$ref_kind" "$short")"
    log_info "$(c_repo "$repo_name") ($ref_display)."
    while IFS=$'\t' read -r addon_name addon_reldir; do
      [[ -z "$addon_name" ]] && continue
      source_path="$(addon_source_path "$clone_dir" "$addon_reldir")"
      log_info "  $(c_addon "$addon_name") -> $(c_path_display "$source_path")"
    done < <(read_repo_addons "$section")
  done <<<"$repos"
}

# Handles `mash remove <repository>`: deletes every mash-managed symlink the
# repository owns, removes the clone directory, and drops the `[repo:<name>]`
# configuration section.
cmd_remove() {
  if [[ $# -ne 1 ]]; then
    die "Usage: $(c_hint 'mash remove <repository>')"
  fi
  local name
  name="$(normalize_name "$1")"
  require_repo "$name"
  local section="repo:$name"

  local client_dir
  client_dir="$(config_get_required main client_dir)"
  local addons_dir="$client_dir/Interface/AddOns"

  local clone_dir
  clone_dir="$(clone_path "$name")"

  # Remove each symlink into this repository's clone. Links are also matched
  # below the data directory, which still exists after the clone was deleted by
  # hand, for a link that spells the profile in another case.
  local addon_name addon_reldir target rest
  while IFS=$'\t' read -r addon_name addon_reldir; do
    [[ -z "$addon_name" ]] && continue
    target="$addons_dir/$addon_name"
    if is_mash_symlink "$target" "$clone_dir" ||
      { [[ -L "$target" ]] && rest="$(path_below "$(link_path "$target")" "$DATA_DIR")" &&
        [[ "$rest" == "clones/$name" || "$rest" == "clones/$name/"* ]]; }; then
      rm -f "$target"
    fi
  done < <(read_repo_addons "$section")

  # Remove the clone.
  rm -rf "$clone_dir"

  # Clean up empty owner directory; harmless if siblings remain.
  rmdir "$(dirname "$clone_dir")" 2>/dev/null || true

  config_remove_section "$section" ||
    die "Cannot write $(c_path_display "$CONFIG_PATH")."

  log_info "$(c_status Removed) $(c_repo "$name")."
}

# Prints the per-command help block for the named subcommand.
print_subcmd_help() {
  case "$1" in
    init)
      cat <<EOF
$(c_bold USAGE)
  $(c_hint "mash init") <$(c_dim client-directory)> [$(c_hint --profile) <$(c_dim name)>] [$(c_hint --interface) <$(c_dim version)>]

Initialize a configuration profile pointing at a WoW client directory and set
it as the active profile. Prompts for the TOC interface version when
$(c_hint --interface) is omitted, listing the supported shortcuts ($(c_bold vanilla) = 11200, $(c_bold tbc) =
20400, $(c_bold wotlk) = 30300). Creates the $(c_path Interface/AddOns) subdirectory under the
client directory if it does not already exist.

The configured interface version is later used to filter which .toc files in a
repository count as installable addons.

$(c_bold OPTIONS)
  $(c_hint --profile) <$(c_dim name)>         new profile name (default: $(c_bold default))
  $(c_hint --interface) <$(c_dim version)>    version or shortcut ($(c_bold vanilla) / $(c_bold tbc) / $(c_bold wotlk))
EOF
      ;;
    use)
      cat <<EOF
$(c_bold USAGE)
  $(c_hint "mash use") <$(c_dim name)>

Switch the active profile. The named profile must already exist; create new
profiles via $(c_hint "mash init <client-directory> --profile <name>").
EOF
      ;;
    drop)
      cat <<EOF
$(c_bold USAGE)
  $(c_hint "mash drop") <$(c_dim name)>

Delete a profile, including its configuration, clones, and mash-managed
symlinks. Addons not managed by mash are left alone.

Refuses to delete the active profile (switch first with $(c_hint "mash use <other>")) or
the only remaining profile (create another one first).
EOF
      ;;
    profile)
      cat <<EOF
$(c_bold USAGE)
  $(c_hint "mash profile")

List configured profiles. The active profile is marked with an asterisk.
EOF
      ;;
    add)
      cat <<EOF
$(c_bold USAGE)
  $(c_hint "mash add") <$(c_dim repository)> [<$(c_dim ref)>] [$(c_hint --toc) <$(c_dim name)>] [$(c_hint --dir) <$(c_dim addon-directory)>]
  $(c_hint "mash add") $(c_hint --file) <$(c_dim file)>

Clone an addon repository into the per-profile cache, detect addons by .toc
file (filtered to the configured interface version), and install symlinks into
the client's $(c_path Interface/AddOns) directory.

The <$(c_dim ref)> argument is optional. If omitted, mash tracks the repository's
default branch. A 7-40 character hex string is treated as a commit hash and
pins the repository; anything else is probed at the remote as a branch first,
then a tag.

The $(c_hint --toc) flag picks a .toc name when an addon directory has multiple matching
.toc files. The $(c_hint --dir) flag picks the addon directory, relative to the
repository root, when separate directories provide an addon with the same name.
Both cases are rare; interactive runs prompt otherwise.

With $(c_hint --file), mash reads one entry per line from a list file (pass $(c_bold -) to read
from stdin). Blank lines and lines starting with # are ignored. Already-added
repositories are skipped; other failures are reported and the batch continues.
A summary line at the end tallies added, skipped, and failed.

$(c_bold OPTIONS)
  $(c_hint --toc) <$(c_dim name)>               select a .toc name when multiple match
  $(c_hint --dir) <$(c_dim addon-directory)>    select an addon directory when names collide
  $(c_hint --file) <$(c_dim file)>              read entries from a file (pass $(c_bold -) for stdin)
EOF
      ;;
    pin)
      cat <<EOF
$(c_bold USAGE)
  $(c_hint "mash pin") <$(c_dim repository)> [<$(c_dim commit-hash)>]

Pin a repository at a specific commit so subsequent $(c_hint "mash update") runs skip it.
With no <$(c_dim commit-hash)>, freezes at the clone's current HEAD; with a
<$(c_dim commit-hash)>, checks out that commit first (fetching from upstream if it is
not in the local clone yet) and then freezes.

A repeat pin against the same already-pinned commit is a no-op success.
EOF
      ;;
    unpin)
      cat <<EOF
$(c_bold USAGE)
  $(c_hint "mash unpin") <$(c_dim repository)> [<$(c_dim ref)>]

Unpin a repository, switch it back to a branch or tag, and clear the pinned
flag. With no <$(c_dim ref)>, switches to the origin's default branch. With a <$(c_dim ref)>,
treats the value as a branch first, then a tag (same probing as $(c_hint "mash add")).
EOF
      ;;
    status)
      cat <<EOF
$(c_bold USAGE)
  $(c_hint "mash status") [<$(c_dim repository)>]

Fetch each tracked repository and report whether updates are available
upstream, without touching the working state. Pinned repositories are skipped
with a message; missing clones emit a warning.

With no <$(c_dim repository)>, checks every tracked repository and emits a summary line
tallying how many are up to date, how many have updates available, and how many
were skipped. Apply available updates with $(c_hint "mash update").
EOF
      ;;
    update)
      cat <<EOF
$(c_bold USAGE)
  $(c_hint "mash update") [<$(c_dim repository)>]

Fetch each tracked repository (git fetch) and reset its working tree to the
recorded ref (git reset --hard). Skips pinned commits with a message.

With no <$(c_dim repository)>, updates every tracked repository. If the upstream layout
has changed in a way that breaks a recorded addon (a .toc was removed or its
interface version no longer matches), mash refuses and tells you to run
$(c_hint "mash refresh") to re-detect the addons.
EOF
      ;;
    refresh)
      cat <<EOF
$(c_bold USAGE)
  $(c_hint "mash refresh") <$(c_dim repository)> [$(c_hint --toc) <$(c_dim name)>] [$(c_hint --dir) <$(c_dim addon-directory)>]

Re-run addon detection against the existing clone and reconcile installed
symlinks to match. Does not fetch, checkout, or reset; pair with $(c_hint "mash update") if
you also need to advance the Git state.

The typical use case is the layout drift that $(c_hint "mash update") refuses to handle (a
.toc was added, removed, renamed, or moved upstream).

Choices recorded by an earlier $(c_hint add) or $(c_hint refresh) are kept while they still apply;
pass $(c_hint --toc) or $(c_hint --dir) to change one.

$(c_bold OPTIONS)
  $(c_hint --toc) <$(c_dim name)>               select a .toc name when multiple match
  $(c_hint --dir) <$(c_dim addon-directory)>    select an addon directory when names collide
EOF
      ;;
    list)
      cat <<EOF
$(c_bold USAGE)
  $(c_hint "mash list")

Print each tracked repository with its tracked ref, current commit, and addons.
Pinned repositories show pinned: <$(c_dim commit-hash)> in place of the ref.
Repositories and addons are listed in case-insensitive order.
EOF
      ;;
    remove)
      cat <<EOF
$(c_bold USAGE)
  $(c_hint "mash remove") <$(c_dim repository)>

Remove a repository and delete the symlinks mash created for its addons. The
clone is removed from the cache and the [repo:<$(c_dim repository)>] section is dropped
from the configuration. Addons not managed by mash are left alone.
EOF
      ;;
  esac
}

# Prints the top-level usage help.
cmd_help() {
  cat <<EOF
$(c_bold mash): manage WoW addons from Git

$(c_bold USAGE)
  $(c_hint mash) [$(c_dim global-flags)] <$(c_dim command)> [<$(c_dim arguments)>]

$(c_bold COMMANDS)
  $(c_hint init)       initialize a configuration profile
  $(c_hint use)        switch to an existing profile
  $(c_hint drop)       delete a profile (configuration, clones, symlinks)
  $(c_hint profile)    list profiles (active marked with *)
  $(c_hint add)        add and install an addon repository
  $(c_hint pin)        pin a repository to a specific commit
  $(c_hint unpin)      unpin and switch to a branch or tag
  $(c_hint status)     check for available updates without applying
  $(c_hint update)     update one or all repositories
  $(c_hint refresh)    re-detect addons in an existing clone
  $(c_hint list)       list installed repositories and addons
  $(c_hint remove)     remove a repository and its symlinks

$(c_bold "GLOBAL FLAGS")
  $(c_hint -v), $(c_hint --verbose)    show Git output
  $(c_hint -q), $(c_hint --quiet)      suppress non-error output
  $(c_hint -h), $(c_hint --help)       show this help

Run $(c_hint "mash <command> --help") for per-command details.

mash is free software and licensed under $(c_bold AGPL-3.0-or-later).
You can find its source code at $(c_url https://github.com/mserajnik/mash).
EOF
}

# Top-level dispatcher: consumes global flags (`-v`, `-q`, `-h`) that appear
# before the command name, sets up color output, resolves the active profile's
# `CONFIG_PATH` and `DATA_DIR` for commands that operate on it, and routes the
# command to its `cmd_*` handler. Anything after the command name passes
# through unchanged so the handler can parse subcommand-specific flags
# (including its own `-h` / `--help`).
parse_global_flags_and_dispatch() {
  local show_help=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -v | --verbose)
        VERBOSE=1
        shift
        ;;
      -q | --quiet)
        QUIET=1
        shift
        ;;
      -h | --help)
        show_help=1
        shift
        ;;
      --)
        shift
        break
        ;;
      -*)
        setup_colors
        die "Unknown global flag '$1' (run $(c_hint "mash --help") for usage)."
        ;;
      *)
        break
        ;;
    esac
  done

  setup_colors

  # No command given: show global help (regardless of whether `-h` / `--help`
  # was present).
  if [[ $# -eq 0 ]]; then
    cmd_help
    exit 0
  fi

  local cmd="$1"
  shift

  # If `-h` / `--help` was not seen before the command, scan the remaining
  # arguments (stopping at `--`) so post-command forms (`mash add --help`,
  # `mash add foo/bar -h`) still trigger per-command help.
  if [[ "$show_help" -eq 0 ]]; then
    local arg
    for arg in "$@"; do
      case "$arg" in
        -h | --help)
          show_help=1
          break
          ;;
        --) break ;;
      esac
    done
  fi

  # Either form of `-h` / `--help` plus a recognized command: print the
  # per-command help and exit before any profile path resolution. An unknown
  # command always falls through to the dispatch case below, which dies with
  # the standard "Unknown command" message.
  if [[ "$show_help" -eq 1 ]]; then
    # Keep the pattern list in sync with the dispatch case below and with the
    # matching case in `validate_profile_name`.
    case "$cmd" in
      init | use | drop | profile | add | pin | unpin | status | update | refresh | list | remove)
        print_subcmd_help "$cmd"
        exit 0
        ;;
    esac
  fi

  # Profile-aware commands (`add`, `pin`, `unpin`, `status`, `update`,
  # `refresh`, `list`, `remove`) need the active profile's paths resolved
  # before they run. Profile management commands (`init`, `use`, `drop`,
  # `profile`) handle the state themselves.
  case "$cmd" in
    add | pin | unpin | status | update | refresh | list | remove)
      resolve_active_paths
      ;;
  esac

  case "$cmd" in
    init) cmd_init "$@" ;;
    use) cmd_use "$@" ;;
    drop) cmd_drop "$@" ;;
    profile) cmd_profile "$@" ;;
    add) cmd_add "$@" ;;
    pin) cmd_pin "$@" ;;
    unpin) cmd_unpin "$@" ;;
    status) cmd_status "$@" ;;
    update) cmd_update "$@" ;;
    refresh) cmd_refresh "$@" ;;
    list) cmd_list "$@" ;;
    remove) cmd_remove "$@" ;;
    *) die "Unknown command '$cmd' (run $(c_hint "mash --help") for usage)." ;;
  esac
}

parse_global_flags_and_dispatch "$@"
